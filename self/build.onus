module build
import std.io
import context
import defs
import ir
import loc
import lowerir
import jsemit
import json
import bundle

-- `onus build` in Onus (impl spec §6, M15.4; `codegen/build.ts` `emitAll`):
-- lowers and emits every loaded module into an output directory as
-- JavaScript, with the generated test file of each module that has tests and
-- the launcher of the entry module's `main`.
pub record Options {
  out_dir: Text
  -- Module specifier for the runtime package, as generated code imports it.
  runtime: Text
  -- Also emit every `verify` block as a function (`onus test --assumptions`).
  verify_all: Bool
  -- Negate the guards of this property's generators (`onus test --mutate`, §20.4).
  negate_guard: Option[Int]
}

pub record Built {
  emitted: List[jsemit.Emitted]
  -- Path of the launcher for the entry module's `main`, when it has one.
  launcher: Option[Text]
}

-- Creates (or truncates) `path` and writes `text` to it.
pub fn write_file(
  files: io.Files,
  path: Text,
  text: Text
) -> Result[Unit, io.Error] may io.file, alloc {
  let f: io.File = try io.create(files: files, path: path)
  try io.write(file: f, text: text)
  return Ok(value: Unit)
}

-- The runtime specifier as the module written at `<out>/<a>/<b>.js` imports it: a relative one
-- (`./onus-runtime/index.js`, the runtime the compiler carries) climbs out of the module's directories.
fn runtime_for(module_name: Text, runtime: Text) -> Text may alloc, mutate {
  if not Text.starts_with(t: runtime, prefix: "./") {
    return runtime
  }
  let depth: Int = List.len(xs: Text.split(t: module_name, sep: ".")) - 1
  if depth <= 0 {
    return runtime
  }
  var up: Text = ""
  for i: Int in 0 ..< depth {
    up = up ++ "../"
  }
  return Text.replace(t: runtime, from: "./", to: up)
}

-- Writes the JavaScript runtime the compiler carries to `<out_dir>/onus-runtime/`, where
-- `./onus-runtime/index.js` finds it (docs/CHANGES.md item 180).
pub fn write_bundled_runtime(
  files: io.Files,
  out_dir: Text
) -> Result[Unit, io.Error] may io.file, alloc, mutate {
  let dir: Text = out_dir ++ "/onus-runtime"
  try io.mkdir(files: files, path: dir)
  for e: bundle.Entry in bundle.under(prefix: "runtime/") {
    try write_file(
      files: files,
      path: dir ++ "/" ++ Text.replace(t: e.path, from: "runtime/", to: ""),
      text: e.text
    )
  }
  return Ok(value: Unit)
}

-- `<out_dir>/<a>/<b>` for the module `a.b`, without an extension.
fn module_path(out_dir: Text, name: Text) -> Text may alloc {
  return out_dir ++ "/" ++ Text.join(parts: Text.split(t: name, sep: "."), sep: "/")
}

-- The directory part of a `/`-separated path.
fn parent_dir(path: Text) -> Text may alloc, mutate {
  let parts: List[Text] = Text.split(t: path, sep: "/")
  var out: Builder[Text] = List.builder()
  for i: Int in 0 ..< List.len(xs: parts) - 1 {
    List.push(b: inout out, x: List.get(xs: parts, i: i))
  }
  return Text.join(parts: List.finish(b: out), sep: "/")
}

-- The launcher's description of `main`: its root capabilities and argument
-- parameter, as `JSON.stringify` prints them.
fn main_json(spec: ir.MainSpec) -> Text may alloc, mutate {
  var roots: Builder[json.Field] = List.builder()
  for r: ir.Root in spec.roots {
    List.push(b: inout roots, x: json.Field { key: r.name, value: json.JString(value: r.kind) })
  }
  var fields: Builder[json.Field] = List.builder()
  List.push(
    b: inout fields,
    x: json.Field { key: "roots", value: json.JObject(fields: List.finish(b: roots)) }
  )
  List.push(b: inout fields, x: json.Field { key: "args", value: json.JString(value: spec.args) })
  List.push(b: inout fields, x: json.Field { key: "status", value: json.JBool(value: spec.status) })
  return json.compact(j: json.JObject(fields: List.finish(b: fields)))
}

-- Emits one module: its code, its tests unless it is a library module of a
-- program, and the launcher when it is the entry module and declares `main`.
fn emit_one(
  ctx: context.Context,
  files: io.Files,
  opts: Options,
  tables: Dict[Int, loc.LineTable],
  m: defs.ModuleRecord,
  entry_std: Bool,
  entry_id: Int,
  emitted: inout Builder[jsemit.Emitted],
  launcher: inout Option[Text]
) -> Result[Unit, io.Error] may io.file, alloc, mutate {
  let lowered: ir.Module = lowerir.lower_module(
    ctx: ctx,
    m: m,
    tables: tables,
    opts: lowerir.Options { verify_all: opts.verify_all, negate_guard: opts.negate_guard }
  )
  let raw: jsemit.Emitted = jsemit.emit_js(
    ctx: ctx,
    m: lowered,
    opts: jsemit.Options { runtime: runtime_for(module_name: m.name, runtime: opts.runtime) }
  )
  var out: jsemit.Emitted = raw
  -- A program's test run is its own examples: the standard library's run with the library, not with every program.
  if m.is_std and not entry_std {
    out = { raw with tests: None }
  }
  List.push(b: inout emitted, x: out)
  let base: Text = module_path(out_dir: opts.out_dir, name: m.name)
  try io.mkdir(files: files, path: parent_dir(path: base))
  try write_file(files: files, path: base ++ ".js", text: out.code)
  match out.tests with
  | Some(value) -> try write_file(files: files, path: base ++ ".examples.test.js", text: value)
  | None -> skip()
  if m.id == entry_id {
    match out.main with
    | Some(value) -> {
      let path: Text = opts.out_dir ++ "/run_" ++ Text.replace(
        t: m.name,
        from: ".",
        to: "_"
      ) ++ ".js"
      let rel: Text = "./" ++ Text.join(parts: Text.split(t: m.name, sep: "."), sep: "/") ++ ".js"
      try write_file(
        files: files,
        path: path,
        text: "// Generated by onus: launches " ++ m.name ++ ".main.\nimport * as $rt from " ++ json.quote(
          t: opts.runtime
        ) ++ ";\nimport { main } from " ++ json.quote(
          t: rel
        ) ++ ";\nprocess.exitCode = $rt.runMain(main, " ++ main_json(
          spec: value
        ) ++ ", process.argv.slice(2));\n"
      )
      launcher = Some(value: path)
    }
    | None -> skip()
  }
  return Ok(value: Unit)
}

fn skip() -> Unit {
  return Unit
}

-- Emits every module of `ctx` into `opts.out_dir`.
-- Preconditions: every pass through `paths` ran without diagnostics.
-- Effects: creates the directory and writes files under it.
pub fn emit_all(
  ctx: context.Context,
  files: io.Files,
  opts: Options
) -> Result[Built, io.Error] may io.file, alloc, mutate {
  try io.mkdir(files: files, path: opts.out_dir)
  try write_file(
    files: files,
    path: opts.out_dir ++ "/package.json",
    text: "{\n  \"type\": \"module\"\n}\n"
  )
  -- Generated tests run with `vitest run --root <out_dir> --config <out_dir>/vitest.config.mjs`.
  try write_file(
    files: files,
    path: opts.out_dir ++ "/vitest.config.mjs",
    text: "export default { test: { include: ['**/*.examples.test.js'], environment: 'node' } };\n"
  )
  let tables: Dict[Int, loc.LineTable] = loc.line_tables(ctx: ctx)
  var emitted: Builder[jsemit.Emitted] = List.builder()
  var launcher: Option[Text] = None
  var entry_std: Bool = true
  var entry_id: Int = -1
  match Map.find(d: ctx.modules, key: 0) with
  | Some(value) -> {
    entry_std = value.is_std
    entry_id = value.id
  }
  | None -> skip()
  for mid: Int in 0 ..< ctx.module_count {
    match Map.find(d: ctx.modules, key: mid) with
    | Some(value) -> try emit_one(
      ctx: ctx,
      files: files,
      opts: opts,
      tables: tables,
      m: value,
      entry_std: entry_std,
      entry_id: entry_id,
      emitted: inout emitted,
      launcher: inout launcher
    )
    | None -> skip()
  }
  return Ok(value: Built { emitted: List.finish(b: emitted), launcher: launcher })
}
