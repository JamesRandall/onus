-- The `onus` command line in Onus (impl spec §2, M15.4; `cli/main.ts`):
-- `check`, `fmt`, `build`, `run`, `test` (examples, properties and laws,
-- docs/CHANGES.md item 189; `--assumptions`, item 191; `--mutate`, item
-- 192), `interface`, `path`, `review` (item 193), `next` (item 195) and
-- `loop` (item 197): every command of the TypeScript `onus`.
--
-- Exit status, as the TypeScript command line reports it (docs/CHANGES.md
-- item 187): 0 success, 1 diagnostics (or a breaking interface, or a native
-- build that failed), 2 usage or I/O failure, and for `run` the program's own,
-- since `run` hands the program the terminal through `io.exec`.
pub const usage: Text = "usage:\n  onus check <file.onus>... [--json] [--root <dir>] [--stdlib <dir>] [--to <pass>] [--budget <ms>] [--ledger] [--no-cache]\n      report every diagnostic; exit 1 if any. Passes: parse, canonical, load, resolve, types, consteval, effects, contracts, claims, capabilities, verify, paths, zones\n  onus fmt <file.onus>... [--stdout]\n      rewrite files in canonical form\n  onus build <entry.onus> [--out <dir>] [--emit js|ir] [--target js|native|wasm] [--root <dir>] [--stdlib <dir>] [--runtime <path>]\n      check, then emit JavaScript for every module into <dir> (default: <entry dir>/out); --target native compiles\n      an executable with clang into <dir>/native (§19); --emit ir prints the target-neutral form\n  onus run <entry.onus> [--out <dir>] [--target js|native|wasm] [-- args...]\n      build, then run the entry module's main\n  onus test <entry.onus> [--out <dir>] [--target js|native|all] [--root <dir>] [--stdlib <dir>]\n      build, then run the generated example, property and law tests (§20.6); --target all runs the examples on\n      both targets and reports any disagreement as E0801 (§19.5)\n  onus test <entry.onus> --mutate [--out <dir>] [--root <dir>] [--stdlib <dir>] [--budget <ms>]\n      weaken each contract in turn and report the weakenings no example, property or law detects (§20.4)\n  onus test <entry.onus> --assumptions [--env <test module>] [--out <dir>] [--root <dir>] [--stdlib <dir>]\n      run every verify block against capabilities from the environment module and record the results in .onus/ledger/ (§20.2–§20.3)\n  onus interface <file.onus> [--json] [--diff <old-interface.json>] [--root <dir>] [--stdlib <dir>] [--budget <ms>] [--no-cache]\n      check, then print the entry module's interface: canonical source with bodies elided, or the §11.1 JSON;\n      with --diff, the changes since a previous interface document (§11.1, §15.1)\n  onus path <file.onus> [<name>] [--json] [--root <dir>] [--stdlib <dir>] [--budget <ms>] [--no-cache]\n      check, then print the §9.1 report of the entry module's paths (or of the named one)\n  onus zone show [--root <dir>]\n      print the manifest's zones and the promotion history (§21)\n  onus zone promote <module> <zone> [--root <dir>] [--stdlib <dir>] [--budget <ms>]\n      check the module at the zone's standard (its policy bundle, the static half of the audit; the\n      regeneration half is deferred) and, when it passes, write the signed manifest and the promotion record\n  onus zone demote <module> <zone> [--root <dir>]\n      always permitted and always recorded; dependents' guarantees become conditional (§21.3)\n  onus --version\n      print the compiler's version\n  onus review <entry.onus> [--out <dir>] [--against <interface.json>] [--root <dir>] [--stdlib <dir>] [--budget <ms>]\n      check, then write the review page and its bundle (§15) into <dir> (default: <entry dir>/review)\n  onus next <file.onus> --offset <n> [--json] [--root <dir>] [--stdlib <dir>]\n      the legal next tokens at the offset (in code points), the expected type there and the names in scope (§14)\n  onus loop run <task.json> [--root <dir>] [--model claude-code[:<model>]|anthropic[:<model>]|openrouter[:<model>]|scripted:<file.json>] [--budget <ms>] [--json] [--no-write]\n      run one task of the regeneration loop to its conclusion (docs/onus-loop-v0.md); exit 0 when a change is opened, 2 when blocked, 1 on error.\n      Keys are read from the environment, or from .env and .env.local in the project root and the current directory:\n      ANTHROPIC_API_KEY, OPENROUTER_API_KEY (and OPENROUTER_MODEL for the default model).\nThe standard library is --stdlib or ONUS_STDLIB, else the one the compiler carries; the runtime for build and run is --runtime or ONUS_RUNTIME, else the one the compiler carries, written beside the program.\n"

pub const passes: List[Text] = [
  "parse",
  "canonical",
  "load",
  "resolve",
  "types",
  "consteval",
  "effects",
  "contracts",
  "claims",
  "capabilities",
  "verify",
  "paths",
  "zones"
]

record Args {
  command: Option[Text]
  files: List[Text]
  flags: Dict[Text, Bool]
  values: Dict[Text, Text]
}

fn skip() -> Unit {
  return Unit
}

fn is_value_flag(name: Text) -> Bool {
  return name == "root" or name == "stdlib" or name == "to" or name == "out" or name == "emit" or name == "budget" or name == "offset" or name == "diff" or name == "against" or name == "env" or name == "target" or name == "runtime" or name == "model"
}

fn parse_args(argv: List[Text]) -> Args may alloc, mutate {
  var command: Option[Text] = None
  var files: Builder[Text] = List.builder()
  var flags: Dict[Text, Bool] = Map.dict()
  var values: Dict[Text, Text] = Map.dict()
  var i: Int where it >= 0 = 0
  loop while i < List.len(xs: argv)
    invariant i >= 0
    decreases List.len(xs: argv) - i
  {
    let a: Text = List.get(xs: argv, i: i)
    if Text.starts_with(t: a, prefix: "--") and Text.count(t: a) >= 2 {
      let name: Text = Text.slice(t: a, from: 2, to: Text.count(t: a))
      if is_value_flag(name: name) and i + 1 < List.len(xs: argv) {
        Map.set(d: inout values, key: name, value: List.get(xs: argv, i: i + 1))
        i = i + 2
      } else {
        if is_value_flag(name: name) {
          i = i + 1
        } else {
          Map.set(d: inout flags, key: name, value: true)
          i = i + 1
        }
      }
    } else {
      if command is None {
        command = Some(value: a)
      } else {
        List.push(b: inout files, x: a)
      }
      i = i + 1
    }
  }
  return Args { command: command, files: List.finish(b: files), flags: flags, values: values }
}

fn flag(args: Args, name: Text) -> Bool {
  return Map.contains(d: args.flags, key: name)
}

fn value(args: Args, name: Text) -> Option[Text] {
  return Map.find(d: args.values, key: name)
}

fn value_or(args: Args, name: Text, fallback: Text) -> Text {
  match Map.find(d: args.values, key: name) with
  | Some(value) -> return value
  | None -> return fallback
}

fn or_empty(o: Option[Text]) -> Text {
  match o with
  | Some(value) -> return value
  | None -> return ""
}

fn is_pass(name: Text) -> Bool {
  return List.contains(xs: passes, x: name)
}

fn plural(n: Int) -> Text {
  if n == 1 {
    return ""
  }
  return "s"
}

fn pad(t: Text, n: Int) -> Text may alloc {
  let width: Int = Text.count(t: t)
  if width >= n {
    return t
  }
  return t ++ Text.repeat(t: " ", n: n - width)
}

fn usage_error(console: io.Console) -> Result[Unit, io.Error] may io.file {
  return Err(error: usage_failure(console: console))
}

-- Prints the usage; the marker `failure_status` reports as 2.
fn usage_failure(console: io.Console) -> io.Error may io.file {
  io.eprint(console: console, text: usage)
  return Other(detail: "usage")
}

-- The context and verifier options a command runs with: the module root is
-- `--root` alone (as the TypeScript command line), the cache lives under
-- `--root` or the entry's directory.
record Setup {
  ctx: context.Context
  vopts: verifier.Options
  root: Text
}

fn setup(
  args: Args,
  files: io.Files,
  env: io.Env,
  clock: io.Clock
) -> Setup may io.file, io.env, io.clock, nondet, alloc, mutate {
  var root: Text = "."
  if List.len(xs: args.files) > 0 {
    root = nativebuild.dir_of(path: List.get(xs: args.files, i: 0))
  }
  match value(args: args, name: "root") with
  | Some(value) -> root = value
  | None -> skip()
  var stdlib: Option[Text] = value(args: args, name: "stdlib")
  if stdlib is None {
    stdlib = io.get_env(env: env, name: "ONUS_STDLIB")
  }
  var budget: Int where it >= 0 = 500
  match value(args: args, name: "budget") with
  | Some(value) -> budget = parse_budget(t: value)
  | None -> skip()
  var cache: Option[Text] = Some(value: root ++ "/.onus/cache")
  if flag(args: args, name: "no-cache") {
    cache = None
  }
  let led: ledger.Ledger = ledger.read_ledger(files: files, dir: root ++ "/.onus/ledger")
  var ctx: context.Context = context.new_context(
    root: value(args: args, name: "root"),
    stdlib: stdlib
  )
  let cfg: config.Config = config.read_config(files: files, root: root)
  ctx = { ctx with
    assumptions: led.assumptions,
    coverage: led.coverage,
    mutations: led.mutations,
    promotions: led.promotions,
    now_ms: io.time(clock: clock),
    assumption_max_age_ms: cfg.max_assumption_age_days * 86400000,
    project_root: Some(value: root)
  }
  return Setup {
    ctx: ctx,
    vopts: verifier.Options { z3_path: None, budget_ms: budget, cache_dir: cache, dump_dir: None },
    root: root
  }
}

-- A positive budget in milliseconds; 500 for anything else.
fn parse_budget(t: Text) -> Int where it >= 0 {
  match Int.parse(t: t) with
  | Some(value) -> {
    if value > 0 {
      return value
    }
    return 500
  }
  | None -> return 500
}

fn or_null(o: Option[json.Json]) -> json.Json {
  match o with
  | Some(value) -> return value
  | None -> return json.JNull
}

fn read_entries(
  ctx: inout context.Context,
  files: io.Files,
  paths: List[Text]
) -> Result[Unit, io.Error] may io.file, alloc, mutate {
  for p: Text in paths {
    let text: Text = try io.read(files: files, path: p)
    if loader.add_file(ctx: inout ctx, path: p, text: text) is None {
      return Err(error: Other(detail: p ++ " is too long"))
    }
  }
  return Ok(value: Unit)
}

fn diag_count(ctx: context.Context) -> Int {
  return List.built(b: ctx.diagnostics)
}

fn emit_diagnostics(
  ctx: context.Context,
  console: io.Console,
  tab: Dict[Int, loc.LineTable],
  as_json: Bool
) -> Unit may io.file, alloc, mutate {
  for d: report.Diagnostic in List.finish(b: ctx.diagnostics) {
    if as_json {
      io.print(
        console: console,
        text: json.compact(j: diagjson.to_json(ctx: ctx, tab: tab, d: d)) ++ "\n"
      )
    } else {
      io.print(console: console, text: diagtext.to_text(ctx: ctx, tab: tab, d: d) ++ "\n")
    }
  }
  return Unit
}

-- One line per obligation of the entry file: the ledger (§11, §12.2).
fn print_ledger(
  ctx: context.Context,
  console: io.Console,
  tab: Dict[Int, loc.LineTable]
) -> Unit may io.file, alloc, mutate {
  for i: Int in 0 ..< ctx.obligation_count {
    let o: obligations.Obligation = context.get_obligation(ctx: ctx, id: i)
    if o.at_file == 0 {
      var by: Text = ""
      match o.by with
      | Some(value) -> by = "  [" ++ value ++ "]"
      | None -> skip()
      io.print(
        console: console,
        text: pad(t: obligations.status_text(s: o.status), n: 8) ++ " " ++ pad(
          t: obligations.kind_text(k: o.kind),
          n: 16
        ) ++ " " ++ loc.location_text(
          ctx: ctx,
          tables: tab,
          file: o.at_file,
          span: o.at_span
        ) ++ "  " ++ context.get_def(ctx: ctx, id: o.def).name ++ ": " ++ o.text ++ by ++ "\n"
      )
    }
  }
  return Unit
}

-- The module declared by the entry file, when it is one.
fn entry_module(ctx: context.Context) -> Option[Int] {
  for mid: Int in 0 ..< ctx.module_count {
    match Map.find(d: ctx.modules, key: mid) with
    | Some(value) -> {
      if value.file == 0 {
        return Some(value: mid)
      }
    }
    | None -> skip()
  }
  return None
}

fn errors_result(
  ctx: context.Context,
  console: io.Console,
  as_json: Bool
) -> Result[Unit, io.Error] may io.file, alloc {
  let n: Int = diag_count(ctx: ctx)
  let line: Text = Int.to_text(x: n) ++ " error" ++ plural(n: n)
  if not as_json {
    io.print(console: console, text: line ++ "\n")
  }
  return Err(error: Other(detail: "diagnostics"))
}

-- `onus check`.
fn check_command(
  args: Args,
  files: io.Files,
  console: io.Console,
  process: io.Process,
  env: io.Env,
  clock: io.Clock
) -> Result[Unit, io.Error] may io.file, io.env, io.clock, nondet, alloc, mutate {
  if List.len(xs: args.files) == 0 {
    return usage_error(console: console)
  }
  let to: Text = value_or(args: args, name: "to", fallback: "zones")
  if not is_pass(name: to) {
    io.eprint(
      console: console,
      text: "onus: unknown pass `" ++ to ++ "`; expected one of " ++ Text.join(
        parts: passes,
        sep: ", "
      ) ++ "\n"
    )
    return Err(error: Other(detail: "unknown pass"))
  }
  let s: Setup = setup(args: args, files: files, env: env, clock: clock)
  var ctx: context.Context = s.ctx
  try read_entries(ctx: inout ctx, files: files, paths: args.files)
  check.run_passes(
    ctx: inout ctx,
    to: check.pass_index(name: to),
    files: files,
    console: console,
    process: process,
    vopts: s.vopts
  )
  let tab: Dict[Int, loc.LineTable] = loc.line_tables(ctx: ctx)
  let as_json: Bool = flag(args: args, name: "json")
  emit_diagnostics(ctx: ctx, console: console, tab: tab, as_json: as_json)
  if flag(args: args, name: "ledger") {
    print_ledger(ctx: ctx, console: console, tab: tab)
  }
  if not context.clean(ctx: ctx) {
    return errors_result(ctx: ctx, console: console, as_json: as_json)
  }
  return Ok(value: Unit)
}

-- `onus fmt`: rewrites files in canonical form, or prints them with `--stdout`.
fn fmt_command(
  args: Args,
  files: io.Files,
  console: io.Console
) -> Result[Unit, io.Error] may io.file, alloc, mutate {
  if List.len(xs: args.files) == 0 {
    return usage_error(console: console)
  }
  var ctx: context.Context = context.new_context(root: None, stdlib: None)
  try read_entries(ctx: inout ctx, files: files, paths: args.files)
  for f: Int in 0 ..< context.file_count(ctx: ctx) {
    loader.canonical(ctx: inout ctx, file: f)
  }
  let tab: Dict[Int, loc.LineTable] = loc.line_tables(ctx: ctx)
  var syntax_errors: Int = 0
  for d: report.Diagnostic in List.finish(b: ctx.diagnostics) {
    if d.code != "E0001" {
      io.print(console: console, text: diagtext.to_text(ctx: ctx, tab: tab, d: d) ++ "\n")
      syntax_errors = syntax_errors + 1
    }
  }
  if syntax_errors > 0 {
    io.eprint(
      console: console,
      text: Int.to_text(x: syntax_errors) ++ " syntax error" ++ plural(n: syntax_errors) ++ "\n"
    )
    return Err(error: Other(detail: "diagnostics"))
  }
  for f: Int in 0 ..< context.file_count(ctx: ctx) {
    match Map.find(d: ctx.canonical, key: f) with
    | Some(value) -> {
      let source: report.SourceFile = context.file_at(ctx: ctx, id: f)
      if flag(args: args, name: "stdout") {
        io.print(console: console, text: value)
      } else {
        if value != source.text {
          try build.write_file(files: files, path: source.path, text: value)
        }
      }
    }
    | None -> skip()
  }
  return Ok(value: Unit)
}

fn io_error_text(e: io.Error) -> Text may alloc {
  match e with
  | NotFound(path) -> return "not found: " ++ path
  | Denied(path) -> return "permission denied: " ++ path
  | Other(detail) -> return detail
}

-- Runs a program on this process's own standard streams — the user's terminal — and
-- returns its exit status as the command's own (docs/CHANGES.md item 187); a program
-- that ended on a signal, or could not start, is 1, as the TypeScript command line reports.
fn run_program(
  process: io.Process,
  console: io.Console,
  program: Text,
  args: List[Text]
) -> Result[Int, io.Error] may io.file, nondet, alloc {
  match io.exec(process: process, program: program, args: args) with
  | Ok(value) -> {
    if value < 0 {
      return Ok(value: 1)
    }
    return Ok(value: value)
  }
  | Err(error) -> {
    io.eprint(
      console: console,
      text: "onus run: cannot run " ++ program ++ ": " ++ io_error_text(e: error) ++ "\n"
    )
    return Ok(value: 1)
  }
}

-- The exit status a command's outcome ends the process with (impl spec: 0 success,
-- 1 diagnostics, 2 usage or I/O failure; §8.3). A failure the command has already
-- reported carries a marker; anything else is printed here.
fn failure_status(console: io.Console, e: io.Error) -> Int may io.file, alloc {
  match e with
  | Other(detail) -> {
    if detail == "diagnostics" or detail == "native build failed" or detail == "breaking" {
      return 1
    }
    if detail == "usage" or detail == "unknown pass" or detail == "--emit ts" or detail == "--emit" or detail == "--target" or detail == "no main" or detail == "not a module" or detail == "not an interface document" or detail == "no such path" or detail == "--assumptions" or detail == "--mutate" or detail == "launcher" or detail == "--offset" {
      return 2
    }
    io.eprint(console: console, text: "onus: " ++ detail ++ "\n")
    return 2
  }
  | _ -> {
    io.eprint(console: console, text: "onus: " ++ io_error_text(e: e) ++ "\n")
    return 2
  }
}

fn exit_status(console: io.Console, r: Result[Unit, io.Error]) -> Int may io.file, alloc {
  match r with
  | Ok(_) -> return 0
  | Err(error) -> return failure_status(console: console, e: error)
}

fn exit_status_of(console: io.Console, r: Result[Int, io.Error]) -> Int may io.file, alloc {
  match r with
  | Ok(value) -> return value
  | Err(error) -> return failure_status(console: console, e: error)
}

-- The runtime a build uses: --runtime, else ONUS_RUNTIME, else the one the compiler
-- carries, written beside the program (docs/CHANGES.md item 180).
record RuntimeChoice {
  runtime: Text
  runtime_dir: Option[Text]
  bundled: Bool
}

fn runtime_choice(args: Args, env: io.Env) -> RuntimeChoice may io.env, alloc, mutate {
  var runtime_opt: Option[Text] = io.get_env(env: env, name: "ONUS_RUNTIME")
  match value(args: args, name: "runtime") with
  | Some(value) -> runtime_opt = Some(value: value)
  | None -> skip()
  match runtime_opt with
  | Some(value) -> return RuntimeChoice {
    runtime: value,
    runtime_dir: runtime_dir_of(runtime: value),
    bundled: false
  }
  | None -> return RuntimeChoice {
    runtime: "./onus-runtime/index.js",
    runtime_dir: None,
    bundled: true
  }
}

-- The native runtime sources next to the runtime package's entry point, when the runtime is given as a path.
fn runtime_dir_of(runtime: Text) -> Option[Text] may alloc, mutate {
  if Text.contains(t: runtime, needle: "/") {
    return Some(value: nativebuild.dir_of(path: nativebuild.dir_of(path: runtime)) ++ "/native")
  }
  return None
}

-- `onus build` and `onus run`.
fn build_command(
  args: Args,
  files: io.Files,
  console: io.Console,
  process: io.Process,
  env: io.Env,
  run: Bool,
  clock: io.Clock
) -> Result[Int, io.Error] may io.file, io.env, io.clock, nondet, alloc, mutate {
  if List.len(xs: args.files) == 0 {
    return Err(error: usage_failure(console: console))
  }
  let entry: Text = List.get(xs: args.files, i: 0)
  let rest: List[Text] = List.slice(xs: args.files, from: 1, to: List.len(xs: args.files))
  let emit: Text = value_or(args: args, name: "emit", fallback: "js")
  if emit == "ts" {
    io.eprint(
      console: console,
      text: "onus: --emit ts is the TypeScript oracle output; the TypeScript `onus` produces it\n"
    )
    return Err(error: Other(detail: "--emit ts"))
  }
  if emit != "js" and emit != "ir" {
    io.eprint(console: console, text: "onus: --emit takes js or ir\n")
    return Err(error: Other(detail: "--emit"))
  }
  let target: Text = value_or(args: args, name: "target", fallback: "js")
  if target != "js" and target != "native" and target != "wasm" {
    io.eprint(console: console, text: "onus: --target takes js, native or wasm\n")
    return Err(error: Other(detail: "--target"))
  }
  let s: Setup = setup(args: args, files: files, env: env, clock: clock)
  var ctx: context.Context = s.ctx
  try read_entries(ctx: inout ctx, files: files, paths: [entry])
  let out_dir: Text = value_or(
    args: args,
    name: "out",
    fallback: nativebuild.dir_of(path: entry) ++ "/out"
  )
  let rt: RuntimeChoice = runtime_choice(args: args, env: env)
  let runtime: Text = rt.runtime
  let runtime_dir: Option[Text] = rt.runtime_dir
  let bundled_runtime: Bool = rt.bundled
  check.run_passes(
    ctx: inout ctx,
    to: 12,
    files: files,
    console: console,
    process: process,
    vopts: s.vopts
  )
  let tab: Dict[Int, loc.LineTable] = loc.line_tables(ctx: ctx)
  let as_json: Bool = flag(args: args, name: "json")
  if emit == "ir" {
    emit_diagnostics(ctx: ctx, console: console, tab: tab, as_json: as_json)
    if not context.clean(ctx: ctx) {
      return Err(error: Other(detail: "diagnostics"))
    }
    for mid: Int in 0 ..< ctx.module_count {
      match Map.find(d: ctx.modules, key: mid) with
      | Some(value) -> {
        if not value.is_std {
          io.print(
            console: console,
            text: irtext.print_ir(
              ctx: ctx,
              m: lowerir.lower_module(
                ctx: ctx,
                m: value,
                tables: tab,
                opts: lowerir.Options { verify_all: false, negate_guard: None }
              )
            )
          )
        }
      }
      | None -> skip()
    }
    return Ok(value: 0)
  }
  if target == "native" or target == "wasm" {
    if not context.clean(ctx: ctx) {
      emit_diagnostics(ctx: ctx, console: console, tab: tab, as_json: as_json)
      return Err(error: Other(detail: "diagnostics"))
    }
    let built: nativebuild.Built = try nativebuild.build_native(
      ctx: inout ctx,
      files: files,
      process: process,
      env: env,
      tab: tab,
      out_dir: out_dir,
      runtime_dir: runtime_dir,
      target: target,
      cflags: []
    )
    emit_diagnostics(ctx: ctx, console: console, tab: tab, as_json: as_json)
    if not context.clean(ctx: ctx) or built.exe is None {
      return Err(error: Other(detail: "native build failed"))
    }
    let exe: Text = or_empty(o: built.exe)
    io.eprint(console: console, text: "onus build: wrote " ++ exe ++ "\n")
    if not run {
      return Ok(value: 0)
    }
    if not built.has_main {
      io.eprint(console: console, text: "onus run: " ++ entry ++ " declares no `pub fn main`\n")
      return Err(error: Other(detail: "no main"))
    }
    if target == "wasm" {
      return run_program(
        process: process,
        console: console,
        program: "node",
        args: [nativebuild.dir_of(path: exe) ++ "/run_wasm.mjs"] ++ rest
      )
    }
    return run_program(process: process, console: console, program: exe, args: rest)
  }
  if not context.clean(ctx: ctx) {
    emit_diagnostics(ctx: ctx, console: console, tab: tab, as_json: as_json)
    return Err(error: Other(detail: "diagnostics"))
  }
  if bundled_runtime {
    try build.write_bundled_runtime(files: files, out_dir: out_dir)
  }
  let built_js: build.Built = try build.emit_all(
    ctx: ctx,
    files: files,
    opts: build.Options {
      out_dir: out_dir,
      runtime: runtime,
      verify_all: false,
      negate_guard: None
    }
  )
  emit_diagnostics(ctx: ctx, console: console, tab: tab, as_json: as_json)
  if not run {
    return Ok(value: 0)
  }
  match built_js.launcher with
  | None -> {
    io.eprint(console: console, text: "onus run: " ++ entry ++ " declares no `pub fn main`\n")
    return Err(error: Other(detail: "no main"))
  }
  | Some(value) -> return run_program(
    process: process,
    console: console,
    program: "node",
    args: [value] ++ rest
  )
}

-- Whether a JSON value has the shape of a §11.1 document, to the extent the diff reads it.
fn is_interface_document(j: json.Json) -> Bool {
  return json.at(j: j, key: "module") is json.JString and json.has(j: j, key: "hash") and json.at(
    j: j,
    key: "items"
  ) is json.JArray
}

-- `onus test` (§20.6; docs/CHANGES.md item 189): the examples, properties and
-- laws on the JavaScript target, the native target, or both compared.
fn test_command(
  args: Args,
  files: io.Files,
  console: io.Console,
  process: io.Process,
  env: io.Env,
  clock: io.Clock
) -> Result[Int, io.Error] may io.file, io.env, io.clock, nondet, alloc, mutate {
  if List.len(xs: args.files) == 0 {
    return Err(error: usage_failure(console: console))
  }
  let entry: Text = List.get(xs: args.files, i: 0)
  if flag(args: args, name: "mutate") {
    return test_mutate(
      args: args,
      entry: entry,
      files: files,
      console: console,
      process: process,
      env: env,
      clock: clock
    )
  }
  let target: Text = value_or(args: args, name: "target", fallback: "js")
  if target != "js" and target != "native" and target != "all" {
    io.eprint(console: console, text: "onus: --target takes js, native or all\n")
    return Err(error: Other(detail: "--target"))
  }
  if flag(args: args, name: "assumptions") {
    return test_assumptions(
      args: args,
      entry: entry,
      files: files,
      console: console,
      process: process,
      env: env,
      clock: clock
    )
  }
  let s: Setup = setup(args: args, files: files, env: env, clock: clock)
  var ctx: context.Context = s.ctx
  try read_entries(ctx: inout ctx, files: files, paths: [entry])
  let out_dir: Text = value_or(
    args: args,
    name: "out",
    fallback: nativebuild.dir_of(path: entry) ++ "/out"
  )
  let rt: RuntimeChoice = runtime_choice(args: args, env: env)
  check.run_passes(
    ctx: inout ctx,
    to: check.pass_index(name: "paths"),
    files: files,
    console: console,
    process: process,
    vopts: s.vopts
  )
  let tab: Dict[Int, loc.LineTable] = loc.line_tables(ctx: ctx)
  let as_json: Bool = flag(args: args, name: "json")
  if not context.clean(ctx: ctx) {
    emit_diagnostics(ctx: ctx, console: console, tab: tab, as_json: as_json)
    return Err(error: Other(detail: "diagnostics"))
  }
  if rt.bundled {
    try build.write_bundled_runtime(files: files, out_dir: out_dir)
  }
  let built_js: build.Built = try build.emit_all(
    ctx: ctx,
    files: files,
    opts: build.Options {
      out_dir: out_dir,
      runtime: rt.runtime,
      verify_all: false,
      negate_guard: None
    }
  )
  emit_diagnostics(ctx: ctx, console: console, tab: tab, as_json: as_json)
  if not context.clean(ctx: ctx) {
    return Err(error: Other(detail: "diagnostics"))
  }
  if target == "js" {
    var any_tests: Bool = false
    for m: jsemit.Emitted in built_js.emitted {
      if m.tests is Some {
        any_tests = true
      }
    }
    if not any_tests {
      io.print(console: console, text: "onus test: no example, property or law to run\n")
      return Ok(value: 0)
    }
    -- The run's coverage alone: what the previous run left is cleared first (§20.5).
    let coverage_dir: Text = out_dir ++ "/coverage"
    try io.remove_all(files: files, path: coverage_dir)
    let status: Int = try io.exec(
      process: process,
      program: "npx",
      args: ["vitest", "run", "--root", out_dir, "--config", "vitest.config.mjs"]
    )
    let ledger_dir: Text = s.root ++ "/.onus/ledger"
    let table: Dict[Text, Int] = testcmd.merge_coverage(
      files: files,
      dir: coverage_dir,
      base: ctx.coverage
    )
    try testcmd.write_coverage(files: files, dir: ledger_dir, table: table)
    ctx = { ctx with coverage: table }
    io.print(
      console: console,
      text: "obligation coverage: " ++ pathtext.coverage_text(
        c: testcmd.program_coverage(ctx: inout ctx, tab: tab)
      ) ++ "\n"
    )
    if status < 0 {
      return Ok(value: 1)
    }
    return Ok(value: status)
  }
  let built: nativebuild.Built = try nativebuild.build_native(
    ctx: inout ctx,
    files: files,
    process: process,
    env: env,
    tab: tab,
    out_dir: out_dir,
    runtime_dir: rt.runtime_dir,
    target: "native",
    cflags: []
  )
  emit_diagnostics(ctx: ctx, console: console, tab: tab, as_json: as_json)
  match built.exe with
  | None -> return Err(error: Other(detail: "diagnostics"))
  | Some(value) -> {
    let native_run: testcmd.NativeRun = testcmd.run_native_examples(process: process, exe: value)
    io.print(console: console, text: native_run.output)
    var native_ok: Bool = true
    for ok: Bool in Map.values(d: native_run.results) {
      if not ok {
        native_ok = false
      }
    }
    if target == "native" {
      if native_ok {
        return Ok(value: 0)
      }
      return Ok(value: 1)
    }
    let js: Dict[Text, Bool] = testcmd.run_js_examples(
      files: files,
      process: process,
      out_dir: out_dir,
      emitted: built_js.emitted,
      include_properties: false
    )
    var js_ok: Bool = true
    for name: Text in Map.keys(d: js) {
      if Map.contains(d: js, key: name) and js_flag(d: js, key: name) {
        io.print(console: console, text: "ok " ++ name ++ " (js)\n")
      } else {
        io.print(console: console, text: "FAIL " ++ name ++ " (js)\n")
        js_ok = false
      }
    }
    let disagreements: Int = testcmd.compare_targets(
      ctx: inout ctx,
      js: js,
      native: native_run.results
    )
    emit_diagnostics(ctx: ctx, console: console, tab: tab, as_json: as_json)
    if disagreements > 0 or not native_ok or not js_ok {
      return Ok(value: 1)
    }
    return Ok(value: 0)
  }
}

-- `onus test --assumptions` (§20.2, §20.3, §20.6; item 191): every verify
-- block against the environment module's capabilities, the outcomes printed
-- and recorded in the ledger under the calendar time of the run.
fn test_assumptions(
  args: Args,
  entry: Text,
  files: io.Files,
  console: io.Console,
  process: io.Process,
  env: io.Env,
  clock: io.Clock
) -> Result[Int, io.Error] may io.file, io.env, io.clock, nondet, alloc, mutate {
  let s: Setup = setup(args: args, files: files, env: env, clock: clock)
  var ctx: context.Context = s.ctx
  let cfg: config.Config = config.read_config(files: files, root: s.root)
  var env_path: Option[Text] = value(args: args, name: "env")
  if env_path is None {
    env_path = config_env_path(cfg: cfg, root: s.root)
  }
  var paths: List[Text] = [entry]
  match env_path with
  | Some(value) -> paths = [entry, value]
  | None -> skip()
  try read_entries(ctx: inout ctx, files: files, paths: paths)
  let out_dir: Text = value_or(
    args: args,
    name: "out",
    fallback: nativebuild.dir_of(path: entry) ++ "/out"
  )
  let rt: RuntimeChoice = runtime_choice(args: args, env: env)
  check.run_passes(
    ctx: inout ctx,
    to: check.pass_index(name: "paths"),
    files: files,
    console: console,
    process: process,
    vopts: s.vopts
  )
  let tab: Dict[Int, loc.LineTable] = loc.line_tables(ctx: ctx)
  let as_json: Bool = flag(args: args, name: "json")
  if not context.clean(ctx: ctx) {
    emit_diagnostics(ctx: ctx, console: console, tab: tab, as_json: as_json)
    return Err(error: Other(detail: "diagnostics"))
  }
  let env_module: Option[defs.ModuleRecord] = module_at_path(ctx: ctx, path: env_path)
  let p: assumptions.Plan = assumptions.plan(ctx: ctx, env: env_module)
  if rt.bundled {
    try build.write_bundled_runtime(files: files, out_dir: out_dir)
  }
  let built: build.Built = try build.emit_all(
    ctx: ctx,
    files: files,
    opts: build.Options {
      out_dir: out_dir,
      runtime: rt.runtime,
      verify_all: true,
      negate_guard: None
    }
  )
  if not assumptions.check(ctx: inout ctx, p: p, emitted: built.emitted) {
    emit_diagnostics(ctx: ctx, console: console, tab: tab, as_json: as_json)
    return Err(error: Other(detail: "diagnostics"))
  }
  let launcher: Text = try assumptions.write_launcher(
    ctx: ctx,
    files: files,
    out_dir: out_dir,
    emitted: built.emitted,
    p: p,
    runtime: rt.runtime
  )
  let run: io.Output = try io.run(
    process: process,
    program: "node",
    args: [launcher],
    stdin: "",
    timeout_ms: 3600000
  )
  if run.status != 0 {
    io.eprint(console: console, text: "onus test: the assumptions launcher failed\n" ++ run.stderr)
    return Err(error: Other(detail: "launcher"))
  }
  let outcomes: List[assumptions.Outcome] = assumptions.parse_outcomes(text: run.stdout)
  let verify_target: Text = value_or(args: args, name: "target", fallback: cfg.target)
  let at: Text = assumptions.iso_of_millis(ms: io.time(clock: clock))
  var led: Dict[Text, tables.VerificationRecord] = Map.dict()
  for key: Text in Map.keys(d: ctx.assumptions) {
    copy_record(from: ctx.assumptions, to: inout led, key: key)
  }
  var failed: Int = 0
  for o: assumptions.Outcome in outcomes {
    Map.set(
      d: inout led,
      key: o.key,
      value: tables.VerificationRecord {
        at: at,
        target: verify_target,
        outcome: o.outcome,
        claim: o.claim,
        def: o.def
      }
    )
    if o.outcome == "failed" {
      failed = failed + 1
    }
    var detail: Text = ""
    if o.detail != "" {
      detail = " (" ++ o.detail ++ ")"
    }
    io.print(
      console: console,
      text: pad(t: o.outcome, n: 7) ++ " " ++ o.def ++ ": " ++ o.claim ++ detail ++ "\n"
    )
  }
  try assumptions.write_ledger(files: files, dir: s.root ++ "/.onus/ledger", led: led)
  let n: Int = List.len(xs: outcomes)
  var plural: Text = "s"
  if n == 1 {
    plural = ""
  }
  io.print(
    console: console,
    text: Int.to_text(
      x: n
    ) ++ " assumption" ++ plural ++ " verified against " ++ verify_target ++ ": " ++ Int.to_text(
      x: n - failed
    ) ++ " passed, " ++ Int.to_text(x: failed) ++ " failed\n"
  )
  if failed > 0 {
    return Ok(value: 1)
  }
  return Ok(value: 0)
}

-- `onus test --mutate` (§20.4; item 192): every contract weakening assessed,
-- the survivors reported as `M0001` rows, and the records written to the
-- ledger under the calendar time of the run.
fn test_mutate(
  args: Args,
  entry: Text,
  files: io.Files,
  console: io.Console,
  process: io.Process,
  env: io.Env,
  clock: io.Clock
) -> Result[Int, io.Error] may io.file, io.env, io.clock, nondet, alloc, mutate {
  let s: Setup = setup(args: args, files: files, env: env, clock: clock)
  var ctx: context.Context = s.ctx
  try read_entries(ctx: inout ctx, files: files, paths: [entry])
  let out_dir: Text = value_or(
    args: args,
    name: "out",
    fallback: nativebuild.dir_of(path: entry) ++ "/out"
  )
  let rt: RuntimeChoice = runtime_choice(args: args, env: env)
  check.run_passes(
    ctx: inout ctx,
    to: check.pass_index(name: "paths"),
    files: files,
    console: console,
    process: process,
    vopts: s.vopts
  )
  let tab: Dict[Int, loc.LineTable] = loc.line_tables(ctx: ctx)
  if not context.clean(ctx: ctx) {
    emit_diagnostics(ctx: ctx, console: console, tab: tab, as_json: flag(args: args, name: "json"))
    return Err(error: Other(detail: "diagnostics"))
  }
  let solver: Option[z3.Solver] = z3.find_z3(process: process, explicit: s.vopts.z3_path)
  if solver is None {
    io.eprint(
      console: console,
      text: "onus test --mutate: z3 not found on PATH; only property guards are mutated\n"
    )
  }
  -- A sibling of the build directory: the program's own test run must not see the mutated programs.
  let records: List[tables.MutationRecord] = try mutate.run(
    ctx: inout ctx,
    files: files,
    process: process,
    plans: mutate.enumerate(ctx: ctx),
    opts: mutate.Options {
      solver: solver,
      budget_ms: s.vopts.budget_ms,
      out_dir: out_dir ++ "-mutate",
      runtime: rt.runtime,
      bundled: rt.bundled
    }
  )
  var surviving: Int = 0
  for r: tables.MutationRecord in records {
    var head: Text = "M0001 undetected contract weakening"
    if r.detected {
      head = "detected"
    } else {
      surviving = surviving + 1
    }
    io.print(
      console: console,
      text: head ++ ": " ++ r.text ++ " in " ++ r.def ++ ": " ++ r.by ++ "\n"
    )
  }
  let n: Int = List.len(xs: records)
  var plural: Text = "s"
  if n == 1 {
    plural = ""
  }
  io.print(
    console: console,
    text: Int.to_text(x: n) ++ " contract mutation" ++ plural ++ ": " ++ Int.to_text(
      x: n - surviving
    ) ++ " detected, " ++ Int.to_text(x: surviving) ++ " surviving\n"
  )
  try mutate.write_ledger(
    files: files,
    dir: s.root ++ "/.onus/ledger",
    records: records,
    at: assumptions.iso_of_millis(ms: io.time(clock: clock))
  )
  return Ok(value: 0)
}

-- The environment module of `onus.json`, relative to the root, as the TypeScript command line joins the two.
fn config_env_path(cfg: config.Config, root: Text) -> Option[Text] may alloc {
  match cfg.env with
  | None -> return None
  | Some(value) -> {
    if root == "." {
      return Some(value: value)
    }
    return Some(value: root ++ "/" ++ value)
  }
}

fn module_at_path(
  ctx: context.Context,
  path: Option[Text]
) -> Option[defs.ModuleRecord] may alloc, mutate {
  match path with
  | None -> return None
  | Some(value) -> return module_of_file(ctx: ctx, file: file_id_of(ctx: ctx, path: value))
}

fn file_id_of(ctx: context.Context, path: Text) -> Int may alloc, mutate {
  for f: report.SourceFile in List.finish(b: ctx.files) {
    if f.path == path {
      return f.id
    }
  }
  return -1
}

fn module_of_file(ctx: context.Context, file: Int) -> Option[defs.ModuleRecord] may alloc, mutate {
  if file < 0 {
    return None
  }
  for m: defs.ModuleRecord in Map.values(d: ctx.modules) {
    if m.file == file {
      return Some(value: m)
    }
  }
  return None
}

fn copy_record(
  from: Dict[Text, tables.VerificationRecord],
  to: inout Dict[Text, tables.VerificationRecord],
  key: Text
) -> Unit may alloc, mutate {
  match Map.find(d: from, key: key) with
  | Some(value) -> Map.set(d: inout to, key: key, value: value)
  | None -> skip()
  return Unit
}

fn js_flag(d: Dict[Text, Bool], key: Text) -> Bool {
  match Map.find(d: d, key: key) with
  | Some(value) -> return value
  | None -> return false
}

-- `onus interface`.
fn interface_command(
  args: Args,
  files: io.Files,
  console: io.Console,
  process: io.Process,
  env: io.Env,
  clock: io.Clock
) -> Result[Unit, io.Error] may io.file, io.env, io.clock, nondet, alloc, mutate {
  if List.len(xs: args.files) == 0 {
    return usage_error(console: console)
  }
  let entry: Text = List.get(xs: args.files, i: 0)
  let s: Setup = setup(args: args, files: files, env: env, clock: clock)
  var ctx: context.Context = s.ctx
  try read_entries(ctx: inout ctx, files: files, paths: [entry])
  check.run_passes(
    ctx: inout ctx,
    to: 12,
    files: files,
    console: console,
    process: process,
    vopts: s.vopts
  )
  let tab: Dict[Int, loc.LineTable] = loc.line_tables(ctx: ctx)
  let as_json: Bool = flag(args: args, name: "json")
  emit_diagnostics(ctx: ctx, console: console, tab: tab, as_json: as_json)
  if not context.clean(ctx: ctx) {
    return Err(error: Other(detail: "diagnostics"))
  }
  var mod: Int = -1
  match entry_module(ctx: ctx) with
  | Some(value) -> mod = value
  | None -> {
    io.eprint(console: console, text: "onus interface: " ++ entry ++ " is not a module\n")
    return Err(error: Other(detail: "not a module"))
  }
  let doc: json.Json = interface.interface_of(ctx: ctx, mod: mod)
  match value(args: args, name: "diff") with
  | Some(value) -> {
    let old_text: Text = try io.read(files: files, path: value)
    let old_doc: json.Json = or_null(o: json.parse(t: old_text))
    if not is_interface_document(j: old_doc) {
      io.eprint(console: console, text: "onus: " ++ value ++ " is not an interface document\n")
      return Err(error: Other(detail: "not an interface document"))
    }
    let d: idiff.Diff = idiff.interface_diff(before: old_doc, after: doc)
    if as_json {
      io.print(console: console, text: json.pretty(j: idiff.diff_json(d: d)) ++ "\n")
    } else {
      io.print(console: console, text: idiff.diff_text(d: d))
    }
    if d.breaking {
      return Err(error: Other(detail: "breaking"))
    }
    return Ok(value: Unit)
  }
  | None -> skip()
  if as_json {
    io.print(console: console, text: json.pretty(j: doc) ++ "\n")
  } else {
    io.print(console: console, text: interface.interface_text(ctx: ctx, mod: mod))
  }
  return Ok(value: Unit)
}

-- `onus loop run <task.json>` (docs/onus-loop-v0.md §10; item 197): one task
-- of the regeneration loop to its conclusion. Exit 0 when a change is opened,
-- 2 when blocked, 1 on error; `watch` is not in v0.
fn loop_command(
  args: Args,
  files: io.Files,
  console: io.Console,
  process: io.Process,
  env: io.Env,
  clock: io.Clock,
  net: io.Net
) -> Result[Int, io.Error] may io.file, io.env, io.clock, io.net, nondet, alloc, mutate {
  if List.len(xs: args.files) < 2 or List.get(xs: args.files, i: 0) != "run" {
    io.eprint(console: console, text: usage)
    if List.len(xs: args.files) > 0 and List.get(xs: args.files, i: 0) == "watch" {
      return Ok(value: 2)
    }
    return Ok(value: 1)
  }
  let task_path: Text = List.get(xs: args.files, i: 1)
  var task_text: Text = ""
  match io.read(files: files, path: task_path) with
  | Err(error) -> {
    io.eprint(
      console: console,
      text: "onus-loop: cannot read " ++ task_path ++ ": " ++ io_error_detail(e: error) ++ "\n"
    )
    return Ok(value: 1)
  }
  | Ok(value) -> task_text = value
  var task_json: json.Json = json.JNull
  match json.parse(t: task_text) with
  | None -> {
    io.eprint(console: console, text: "onus-loop: cannot read " ++ task_path ++ ": not JSON\n")
    return Ok(value: 1)
  }
  | Some(value) -> task_json = value
  var task: regen.Task = regen.Task {
    id: "",
    kind: "",
    scope: [],
    target: None,
    counterexample: None,
    budget: regen.Budget { iterations: 0, tokens: 0, wall_ms: 0 },
    context_policy: "",
    origin: None,
    description: None,
    helpers: false,
    alternate_model: None
  }
  match regen.parse_task(j: task_json) with
  | Err(error) -> {
    io.eprint(console: console, text: "onus-loop: " ++ error ++ "\n")
    return Ok(value: 1)
  }
  | Ok(value) -> task = value
  let root: Text = value_or(args: args, name: "root", fallback: ".")
  var model: regen.Model = regen.Scripted(answers: [])
  match regen.model_from_spec(
    spec: value_or(args: args, name: "model", fallback: "claude-code"),
    env: env,
    files: files,
    env_dirs: [root, "."]
  ) with
  | Err(error) -> {
    io.eprint(console: console, text: "onus-loop: " ++ error ++ "\n")
    return Ok(value: 1)
  }
  | Ok(value) -> model = value
  var budget: Int = 2000
  match value(args: args, name: "budget") with
  | Some(value) -> budget = parse_int_or(t: value, dflt: 2000)
  | None -> skip()
  var stdlib: Option[Text] = value(args: args, name: "stdlib")
  if stdlib is None {
    stdlib = io.get_env(env: env, name: "ONUS_STDLIB")
  }
  let rt: RuntimeChoice = runtime_choice(args: args, env: env)
  let outcome: regen.Outcome = try regen.run_task(
    task: task,
    files: files,
    console: console,
    process: process,
    net: net,
    clock: clock,
    opts: regen.Options {
      root: root,
      model: model,
      tools: regen.Tools {
        stdlib: stdlib,
        runtime: rt.runtime,
        bundled: rt.bundled,
        budget_ms: budget
      },
      write: not flag(args: args, name: "no-write")
    }
  )
  if outcome.status == "error" {
    io.eprint(
      console: console,
      text: "onus-loop: " ++ value_or_text(o: outcome.error, dflt: "error") ++ "\n"
    )
    return Ok(value: 1)
  }
  match outcome.change with
  | None -> skip()
  | Some(value) -> {
    if flag(args: args, name: "json") {
      io.print(console: console, text: json.compact(j: value) ++ "\n")
    } else {
      let m: json.Json = json.at(j: value, key: "metrics")
      var head: Text = "blocked (" ++ value_or_text(
        o: str_or_none(j: json.at(j: value, key: "cause")),
        dflt: "unknown"
      ) ++ ")"
      if json.str_at(j: value, key: "status") == "opened" {
        head = "change opened"
      }
      io.print(
        console: console,
        text: head ++ ": " ++ counted(
          n: json.int_at(j: m, key: "iterations"),
          word: "iteration"
        ) ++ ", " ++ counted(
          n: json.int_at(j: m, key: "mechanical_repairs"),
          word: "mechanical repair"
        ) ++ ", " ++ counted(
          n: json.int_at(j: m, key: "escalation_steps"),
          word: "escalation step"
        ) ++ ", " ++ counted(
          n: json.int_at(j: m, key: "proposals"),
          word: "proposal"
        ) ++ ", " ++ Int.to_text(x: json.int_at(j: m, key: "tokens")) ++ " tokens\n"
      )
      for p: json.Json in json.list_at(j: value, key: "proposals") {
        io.print(
          console: console,
          text: "  proposal " ++ json.str_at(j: p, key: "kind") ++ " for " ++ json.str_at(
            j: p,
            key: "def"
          ) ++ ": " ++ json.str_at(j: p, key: "rationale") ++ "\n"
        )
      }
      for f: json.Json in json.list_at(j: value, key: "audit") {
        io.print(
          console: console,
          text: "  audit " ++ json.str_at(j: f, key: "finding") ++ ": " ++ json.str_at(
            j: f,
            key: "detail"
          ) ++ "\n"
        )
      }
      print_path(console: console, path: outcome.path)
    }
  }
  if outcome.status == "change" {
    return Ok(value: 0)
  }
  return Ok(value: 2)
}

fn parse_int_or(t: Text, dflt: Int) -> Int {
  match Int.parse(t: t) with
  | Some(value) -> return value
  | None -> return dflt
}

fn print_path(console: io.Console, path: Option[Text]) -> Unit may io.file, alloc {
  match path with
  | Some(value) -> io.print(console: console, text: "  " ++ value ++ "\n")
  | None -> skip()
  return Unit
}

fn counted(n: Int, word: Text) -> Text may alloc {
  if n == 1 {
    return Int.to_text(x: n) ++ " " ++ word
  }
  return Int.to_text(x: n) ++ " " ++ word ++ "s"
}

fn value_or_text(o: Option[Text], dflt: Text) -> Text {
  match o with
  | Some(value) -> return value
  | None -> return dflt
}

fn str_or_none(j: json.Json) -> Option[Text] {
  match j with
  | json.JString(value) -> return Some(value: value)
  | _ -> return None
}

fn io_error_detail(e: io.Error) -> Text may alloc {
  match e with
  | NotFound(path) -> return "not found: " ++ path
  | Denied(path) -> return "denied: " ++ path
  | Other(detail) -> return detail
}

-- `onus next` (§14; item 195): the completion state at an offset of a file.
fn next_command(
  args: Args,
  files: io.Files,
  console: io.Console,
  env: io.Env,
  clock: io.Clock
) -> Result[Int, io.Error] may io.file, io.env, io.clock, nondet, alloc, mutate {
  if List.len(xs: args.files) == 0 or value(args: args, name: "offset") is None {
    return Err(error: usage_failure(console: console))
  }
  let entry: Text = List.get(xs: args.files, i: 0)
  var offset: Int = -1
  match Int.parse(t: value_or(args: args, name: "offset", fallback: "")) with
  | Some(value) -> offset = value
  | None -> skip()
  if offset < 0 {
    io.eprint(console: console, text: "onus next: --offset takes a non-negative integer\n")
    return Err(error: Other(detail: "--offset"))
  }
  let text: Text = try io.read(files: files, path: entry)
  let s: Setup = setup(args: args, files: files, env: env, clock: clock)
  var ctx: context.Context = s.ctx
  let r: nextcmd.NextResult = nextcmd.next(
    ctx: inout ctx,
    files: files,
    path: entry,
    text: text,
    offset: offset
  )
  if flag(args: args, name: "json") {
    io.print(
      console: console,
      text: json.compact(
        j: json.JObject(
          fields: [
            json.field(key: "tokens", value: json.texts(ts: r.tokens)),
            json.field(key: "expectedType", value: json.text_or_null(o: r.expected_type)),
            json.field(key: "inScope", value: json.texts(ts: r.in_scope))
          ]
        )
      ) ++ "\n"
    )
    return Ok(value: 0)
  }
  var expected: Text = "(none)"
  match r.expected_type with
  | Some(value) -> expected = value
  | None -> skip()
  io.print(
    console: console,
    text: "tokens: " ++ Text.join(
      parts: r.tokens,
      sep: " "
    ) ++ "\nexpected: " ++ expected ++ "\nin scope: " ++ Text.join(
      parts: r.in_scope,
      sep: ", "
    ) ++ "\n"
  )
  return Ok(value: 0)
}

-- The workbench the compiler carries (item 210: `self/workbench.onus` built
-- by stage0 into the bundle under `workbench/`) and the runtime, written
-- beside the page so that the directory is the live page.
fn write_workbench(
  files: io.Files,
  out_dir: Text
) -> Result[Unit, io.Error] may io.file, alloc, mutate {
  for e: bundle.Entry in bundle.under(prefix: "workbench/") {
    let rel: Text = Text.replace(t: e.path, from: "workbench/", to: "")
    if Text.contains(t: rel, needle: "/") {
      try io.mkdir(files: files, path: out_dir ++ "/" ++ nativebuild.dir_of(path: rel))
    }
    try build.write_file(files: files, path: out_dir ++ "/" ++ rel, text: e.text)
  }
  try build.write_bundled_runtime(files: files, out_dir: out_dir)
  return Ok(value: Unit)
}

-- `onus review` (§15; item 193): the review bundle and page written into the
-- output directory after the pipeline ran to paths; diagnostics are
-- reported and the page then holds them alone.
fn review_command(
  args: Args,
  files: io.Files,
  console: io.Console,
  process: io.Process,
  env: io.Env,
  clock: io.Clock
) -> Result[Int, io.Error] may io.file, io.env, io.clock, nondet, alloc, mutate {
  if List.len(xs: args.files) == 0 {
    return Err(error: usage_failure(console: console))
  }
  let entry: Text = List.get(xs: args.files, i: 0)
  var against: Option[json.Json] = None
  match value(args: args, name: "against") with
  | Some(value) -> {
    let old_text: Text = try io.read(files: files, path: value)
    let old_doc: json.Json = or_null(o: json.parse(t: old_text))
    if not is_interface_document(j: old_doc) {
      io.eprint(console: console, text: "onus: " ++ value ++ " is not an interface document\n")
      return Err(error: Other(detail: "not an interface document"))
    }
    against = Some(value: old_doc)
  }
  | None -> skip()
  let s: Setup = setup(args: args, files: files, env: env, clock: clock)
  var ctx: context.Context = s.ctx
  try read_entries(ctx: inout ctx, files: files, paths: [entry])
  check.run_passes(
    ctx: inout ctx,
    to: 12,
    files: files,
    console: console,
    process: process,
    vopts: s.vopts
  )
  let tab: Dict[Int, loc.LineTable] = loc.line_tables(ctx: ctx)
  emit_diagnostics(ctx: ctx, console: console, tab: tab, as_json: flag(args: args, name: "json"))
  let data: json.Json = review.review_data(
    ctx: ctx,
    tab: tab,
    against: against,
    now: assumptions.iso_of_millis(ms: io.time(clock: clock)),
    changes: review.read_changes(files: files, root: s.root)
  )
  let out_dir: Text = value_or(
    args: args,
    name: "out",
    fallback: nativebuild.dir_of(path: entry) ++ "/review"
  )
  try io.mkdir(files: files, path: out_dir)
  try build.write_file(
    files: files,
    path: out_dir ++ "/index.html",
    text: review.render_page(data: data)
  )
  try build.write_file(
    files: files,
    path: out_dir ++ "/review.json",
    text: json.pretty(j: data) ++ "\n"
  )
  try write_workbench(files: files, out_dir: out_dir)
  io.eprint(console: console, text: "onus review: wrote " ++ out_dir ++ "/index.html\n")
  if not context.clean(ctx: ctx) {
    return Err(error: Other(detail: "diagnostics"))
  }
  return Ok(value: 0)
}

-- `onus path`.
fn path_command(
  args: Args,
  files: io.Files,
  console: io.Console,
  process: io.Process,
  env: io.Env,
  clock: io.Clock
) -> Result[Unit, io.Error] may io.file, io.env, io.clock, nondet, alloc, mutate {
  if List.len(xs: args.files) == 0 {
    return usage_error(console: console)
  }
  let entry: Text = List.get(xs: args.files, i: 0)
  var wanted: Option[Text] = None
  if List.len(xs: args.files) > 1 {
    wanted = Some(value: List.get(xs: args.files, i: 1))
  }
  let s: Setup = setup(args: args, files: files, env: env, clock: clock)
  var ctx: context.Context = s.ctx
  try read_entries(ctx: inout ctx, files: files, paths: [entry])
  check.run_passes(
    ctx: inout ctx,
    to: 12,
    files: files,
    console: console,
    process: process,
    vopts: s.vopts
  )
  let tab: Dict[Int, loc.LineTable] = loc.line_tables(ctx: ctx)
  let as_json: Bool = flag(args: args, name: "json")
  emit_diagnostics(ctx: ctx, console: console, tab: tab, as_json: as_json)
  var entry_mod: Int = -1
  match entry_module(ctx: ctx) with
  | Some(value) -> entry_mod = value
  | None -> skip()
  var reports: Builder[json.Json] = List.builder()
  for k: Int in Map.keys(d: ctx.analyses) {
    match Map.find(d: ctx.analyses, key: k) with
    | Some(value) -> {
      if value.mod == entry_mod {
        var chosen: Bool = true
        if wanted is Some {
          chosen = context.get_def(ctx: ctx, id: value.def).name == or_empty(o: wanted)
        }
        if chosen {
          List.push(b: inout reports, x: pathreport.path_report(ctx: ctx, tab: tab, a: value))
        }
      }
    }
    | None -> skip()
  }
  let found: List[json.Json] = List.finish(b: reports)
  if wanted is Some and List.len(xs: found) == 0 and context.clean(ctx: ctx) {
    io.eprint(
      console: console,
      text: "onus path: no path `" ++ or_empty(o: wanted) ++ "` in " ++ entry ++ "\n"
    )
    return Err(error: Other(detail: "no such path"))
  }
  for r: json.Json in found {
    if as_json {
      io.print(console: console, text: json.pretty(j: r) ++ "\n")
    } else {
      io.print(console: console, text: pathtext.path_text(r: r))
    }
  }
  if not context.clean(ctx: ctx) {
    return Err(error: Other(detail: "diagnostics"))
  }
  return Ok(value: Unit)
}

pub fn main(
  args: List[Text],
  files: io.Files,
  console: io.Console,
  process: io.Process,
  env: io.Env,
  clock: io.Clock,
  net: io.Net
) -> Result[Int, io.Error] may io.file, io.env, io.clock, io.net, nondet, alloc, mutate {
  let a: Args = parse_args(argv: args)
  if flag(args: a, name: "version") {
    io.print(console: console, text: "onus " ++ bundle.version ++ "\n")
    return Ok(value: 0)
  }
  match a.command with
  | None -> return Ok(value: exit_status(console: console, r: usage_error(console: console)))
  | Some(value) -> {
    if value == "check" {
      return Ok(
        value: exit_status(
          console: console,
          r: check_command(
            args: a,
            files: files,
            console: console,
            process: process,
            env: env,
            clock: clock
          )
        )
      )
    }
    if value == "fmt" {
      return Ok(
        value: exit_status(
          console: console,
          r: fmt_command(args: a, files: files, console: console)
        )
      )
    }
    if value == "build" or value == "run" {
      return Ok(
        value: exit_status_of(
          console: console,
          r: build_command(
            args: a,
            files: files,
            console: console,
            process: process,
            env: env,
            run: value == "run",
            clock: clock
          )
        )
      )
    }
    if value == "test" {
      return Ok(
        value: exit_status_of(
          console: console,
          r: test_command(
            args: a,
            files: files,
            console: console,
            process: process,
            env: env,
            clock: clock
          )
        )
      )
    }
    if value == "interface" {
      return Ok(
        value: exit_status(
          console: console,
          r: interface_command(
            args: a,
            files: files,
            console: console,
            process: process,
            env: env,
            clock: clock
          )
        )
      )
    }
    if value == "path" {
      return Ok(
        value: exit_status(
          console: console,
          r: path_command(
            args: a,
            files: files,
            console: console,
            process: process,
            env: env,
            clock: clock
          )
        )
      )
    }
    if value == "loop" {
      return loop_command(
        args: a,
        files: files,
        console: console,
        process: process,
        env: env,
        clock: clock,
        net: net
      )
    }
    if value == "next" {
      return Ok(
        value: exit_status_of(
          console: console,
          r: next_command(args: a, files: files, console: console, env: env, clock: clock)
        )
      )
    }
    if value == "zone" {
      return Ok(
        value: exit_status_of(
          console: console,
          r: zone_command(
            args: a,
            files: files,
            console: console,
            process: process,
            env: env,
            clock: clock,
            net: net
          )
        )
      )
    }
    if value == "review" {
      return Ok(
        value: exit_status_of(
          console: console,
          r: review_command(
            args: a,
            files: files,
            console: console,
            process: process,
            env: env,
            clock: clock
          )
        )
      )
    }
    return Ok(value: exit_status(console: console, r: usage_error(console: console)))
  }
}

-- `onus zone show | promote <module> <zone> | demote <module> <zone>` (spec
-- §21.3; docs/CHANGES.md item 203). The root is `--root` or the working
-- directory; a module's source is `<root>/<module with dots as slashes>.onus`.
-- `promote` runs the pipeline over that source with the module at the target
-- zone in a candidate manifest, refuses on any diagnostic, and otherwise
-- writes the signed manifest and a promotion record; with `--model <spec>`
-- the audit's regeneration half runs first (loop spec §8): a `regenerate`
-- task over the module, whose findings, or a blocked or failed run, refuse
-- the promotion; without it the record says the regeneration was skipped.
-- `demote` writes and records without checking. Exit 0 when done, 1 when
-- refused, 2 for a usage error.
fn zone_command(
  args: Args,
  files: io.Files,
  console: io.Console,
  process: io.Process,
  env: io.Env,
  clock: io.Clock,
  net: io.Net
) -> Result[Int, io.Error] may io.file, io.env, io.clock, io.net, nondet, alloc, mutate {
  if List.len(xs: args.files) == 0 {
    return Err(error: usage_failure(console: console))
  }
  let sub: Text = List.get(xs: args.files, i: 0)
  var root: Text = "."
  match value(args: args, name: "root") with
  | Some(value) -> root = value
  | None -> skip()
  var manifest: zones.Manifest = zones.empty_manifest()
  match zones.read_manifest(files: files, root: Some(value: root)) with
  | Err(error) -> {
    io.eprint(console: console, text: "onus zone: onus.toml: " ++ error ++ "\n")
    return Ok(value: 1)
  }
  | Ok(value) -> manifest = manifest_or_empty(o: value)
  let led: ledger.Ledger = ledger.read_ledger(files: files, dir: root ++ "/.onus/ledger")
  if sub == "show" {
    io.print(console: console, text: zones.canonical_text(m: manifest))
    for r: tables.PromotionRecord in led.promotions {
      io.print(
        console: console,
        text: r.kind ++ " " ++ r.module ++ ": " ++ r.from ++ " -> " ++ r.to ++ " at " ++ r.at ++ " (" ++ r.audit ++ ")\n"
      )
    }
    return Ok(value: 0)
  }
  if (sub != "promote" and sub != "demote") or List.len(xs: args.files) < 3 {
    return Err(error: usage_failure(console: console))
  }
  let module: Text = List.get(xs: args.files, i: 1)
  let zone: Text = List.get(xs: args.files, i: 2)
  if not zones.is_zone(t: zone) {
    io.eprint(
      console: console,
      text: "onus zone: `" ++ zone ++ "` is not a zone (draft, hardened or critical)\n"
    )
    return Err(error: Other(detail: "usage"))
  }
  let from: Text = zones.zone_of(m: manifest, name: module)
  let candidate: zones.Manifest = zones.set_zone(m: manifest, module: module, zone: zone)
  let at: Text = assumptions.iso_of_millis(ms: io.time(clock: clock))
  var audit: Text = "demotion; not audited"
  if sub == "promote" {
    let source: Text = root ++ "/" ++ Text.replace(t: module, from: ".", to: "/") ++ ".onus"
    let candidate_dir: Text = root ++ "/.onus/zone-candidate"
    try io.mkdir(files: files, path: candidate_dir)
    try zones.write_manifest(files: files, root: candidate_dir, m: candidate)
    var stdlib: Option[Text] = value(args: args, name: "stdlib")
    if stdlib is None {
      stdlib = io.get_env(env: env, name: "ONUS_STDLIB")
    }
    var budget: Int where it >= 0 = 500
    match value(args: args, name: "budget") with
    | Some(value) -> budget = parse_budget(t: value)
    | None -> skip()
    var ctx: context.Context = context.new_context(root: Some(value: root), stdlib: stdlib)
    let cfg: config.Config = config.read_config(files: files, root: root)
    ctx = { ctx with
      assumptions: led.assumptions,
      coverage: led.coverage,
      mutations: led.mutations,
      promotions: led.promotions,
      now_ms: io.time(clock: clock),
      assumption_max_age_ms: cfg.max_assumption_age_days * 86400000,
      project_root: Some(value: candidate_dir)
    }
    if io.read(files: files, path: source) is Err {
      io.eprint(
        console: console,
        text: "onus zone: no source for `" ++ module ++ "` at " ++ source ++ "\n"
      )
      return Ok(value: 1)
    }
    -- The whole project is the unit of the check: the paths that cover the module's functions are
    -- declared wherever the project declares them, so every source under the root is an entry.
    for path: Text in project_sources(files: files, dir: root, depth: 6) {
      match io.read(files: files, path: path) with
      | Ok(value) -> {
        if loader.add_file(ctx: inout ctx, path: path, text: value) is None {
          return Err(error: Other(detail: path ++ " is too long"))
        }
      }
      | Err(_) -> skip()
    }
    check.run_passes(
      ctx: inout ctx,
      to: check.pass_index(name: "zones"),
      files: files,
      console: console,
      process: process,
      vopts: verifier.Options {
        z3_path: None,
        budget_ms: budget,
        cache_dir: Some(value: root ++ "/.onus/cache"),
        dump_dir: None
      }
    )
    let tab: Dict[Int, loc.LineTable] = loc.line_tables(ctx: ctx)
    if List.built(b: ctx.diagnostics) > 0 {
      emit_diagnostics(ctx: ctx, console: console, tab: tab, as_json: false)
      io.print(
        console: console,
        text: "promotion refused: `" ++ module ++ "` does not meet `" ++ zone ++ "` (§21.2)\n"
      )
      return Ok(value: 1)
    }
    -- The audit's findings are recorded, never a gate (§21.3 as changed by item 204): what
    -- promotion rests on is the policy bundle the pass just checked.
    audit = "policies passed; " ++ mutation_summary(
      module: module,
      records: led.mutations
    ) ++ "; regeneration skipped"
    match value(args: args, name: "model") with
    | None -> skip()
    | Some(value) -> {
      let regenerated: Text = try audited_regeneration(
        spec: value,
        module: module,
        root: root,
        stdlib: stdlib,
        budget: budget,
        args: args,
        files: files,
        console: console,
        process: process,
        env: env,
        clock: clock,
        net: net
      )
      audit = "policies passed; " ++ mutation_summary(
        module: module,
        records: led.mutations
      ) ++ "; " ++ regenerated
    }
  }
  try zones.write_manifest(files: files, root: root, m: candidate)
  var kind: Text = "promotion"
  if sub == "demote" {
    kind = "demotion"
  }
  let record: tables.PromotionRecord = tables.PromotionRecord {
    module: module,
    from: from,
    to: zone,
    at: at,
    kind: kind,
    audit: audit
  }
  try ledger.write_promotions(
    files: files,
    dir: root ++ "/.onus/ledger",
    records: led.promotions ++ [record]
  )
  io.print(
    console: console,
    text: kind ++ ": `" ++ module ++ "` " ++ from ++ " -> " ++ zone ++ " (" ++ audit ++ ")\n"
  )
  return Ok(value: 0)
}

fn manifest_or_empty(o: Option[zones.Manifest]) -> zones.Manifest may alloc {
  match o with
  | Some(value) -> return value
  | None -> return zones.empty_manifest()
}

-- Every `.onus` file under `dir`, `depth` levels down, sorted per directory; dot-directories and
-- generated ones (`out`, `review`, `node_modules`) are not the project's.
fn project_sources(
  files: io.Files,
  dir: Text,
  depth: Int where it >= 0
) -> List[Text] may io.file, alloc, mutate
  decreases depth
{
  var out: Builder[Text] = List.builder()
  match io.list_dir(files: files, path: dir) with
  | Err(_) -> skip()
  | Ok(value) -> {
    for name: Text in value {
      if Text.ends_with(t: name, suffix: ".onus") and not Text.starts_with(t: name, prefix: ".") {
        List.push(b: inout out, x: dir ++ "/" ++ name)
      }
    }
    if depth > 0 {
      for name: Text in value {
        if not Text.starts_with(t: name, prefix: ".") and not Text.contains(
          t: name,
          needle: "."
        ) and name != "out" and name != "review" and name != "node_modules" and name != "out-mutate" {
          for p: Text in project_sources(files: files, dir: dir ++ "/" ++ name, depth: depth - 1) {
            List.push(b: inout out, x: p)
          }
        }
      }
    }
  }
  return List.finish(b: out)
}

-- The regeneration half of the promotion audit (spec §21.3; loop spec §8):
-- a `regenerate` task over `module` with the given model, its change
-- written under `.onus/changes/promote_<module>/`. The result is the text
-- the promotion record carries: passed with its iteration count, its
-- findings, or why the run did not conclude; the findings are printed too.
fn audited_regeneration(
  spec: Text,
  module: Text,
  root: Text,
  stdlib: Option[Text],
  budget: Int where it >= 0,
  args: Args,
  files: io.Files,
  console: io.Console,
  process: io.Process,
  env: io.Env,
  clock: io.Clock,
  net: io.Net
) -> Result[Text, io.Error] may io.file, io.env, io.clock, io.net, nondet, alloc, mutate {
  var model: regen.Model = regen.Scripted(answers: [])
  match regen.model_from_spec(spec: spec, env: env, files: files, env_dirs: [root, "."]) with
  | Err(error) -> return Ok(value: "regeneration did not run: " ++ error)
  | Ok(value) -> model = value
  let task_json: json.Json = json.JObject(
    fields: [
      json.field(
        key: "id",
        value: json.text(t: "promote_" ++ Text.replace(t: module, from: ".", to: "_"))
      ),
      json.field(key: "kind", value: json.text(t: "regenerate")),
      json.field(key: "scope", value: json.texts(ts: [module]))
    ]
  )
  var task: regen.Task = regen.Task {
    id: "",
    kind: "regenerate",
    scope: [],
    target: None,
    counterexample: None,
    budget: regen.Budget { iterations: 0, tokens: 0, wall_ms: 0 },
    context_policy: "",
    origin: None,
    description: None,
    helpers: false,
    alternate_model: None
  }
  match regen.parse_task(j: task_json) with
  | Err(error) -> return Ok(value: "regeneration did not run: " ++ error)
  | Ok(value) -> task = value
  let rt: RuntimeChoice = runtime_choice(args: args, env: env)
  let outcome: regen.Outcome = try regen.run_task(
    task: task,
    files: files,
    console: console,
    process: process,
    net: net,
    clock: clock,
    opts: regen.Options {
      root: root,
      model: model,
      tools: regen.Tools {
        stdlib: stdlib,
        runtime: rt.runtime,
        bundled: rt.bundled,
        budget_ms: budget
      },
      write: true
    }
  )
  if outcome.status == "error" {
    return Ok(value: "regeneration did not run: " ++ value_or_text(o: outcome.error, dflt: "error"))
  }
  match outcome.change with
  | None -> return Ok(value: "regeneration " ++ outcome.status)
  | Some(value) -> return Ok(
    value: audit_of_change(console: console, change: value, status: outcome.status)
  )
}

-- The audit text of a concluded regeneration: passed with its iteration count, or its findings, printed.
fn audit_of_change(
  console: io.Console,
  change: json.Json,
  status: Text
) -> Text may io.file, alloc, mutate {
  let findings: List[json.Json] = json.list_at(j: change, key: "audit")
  let iterations: Int = json.int_at(j: json.at(j: change, key: "metrics"), key: "iterations")
  if status != "change" {
    var why: Text = "regeneration " ++ status
    if json.has(j: change, key: "cause") {
      why = why ++ " (" ++ json.str_at(j: change, key: "cause") ++ ")"
    }
    return why ++ " after " ++ Int.to_text(x: iterations) ++ " iteration(s)"
  }
  if List.len(xs: findings) == 0 {
    return "regeneration passed in " ++ Int.to_text(x: iterations) ++ " iteration(s)"
  }
  for f: json.Json in findings {
    io.print(
      console: console,
      text: "finding " ++ json.str_at(j: f, key: "finding") ++ ": " ++ json.str_at(
        j: f,
        key: "detail"
      ) ++ "\n"
    )
  }
  return "regeneration: " ++ Int.to_text(
    x: List.len(xs: findings)
  ) ++ " finding(s) in " ++ Int.to_text(x: iterations) ++ " iteration(s)"
}

-- The module's contract mutations from the ledger (§20.4): detected and surviving counts.
fn mutation_summary(module: Text, records: List[tables.MutationRecord]) -> Text may alloc {
  var detected: Int = 0
  var surviving: Int = 0
  for r: tables.MutationRecord in records {
    if Text.starts_with(t: r.def, prefix: module ++ ".") {
      if r.detected {
        detected = detected + 1
      } else {
        surviving = surviving + 1
      }
    }
  }
  return "mutations: " ++ Int.to_text(x: detected) ++ " detected, " ++ Int.to_text(
    x: surviving
  ) ++ " surviving"
}
