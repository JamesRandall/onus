module ledger
import std.io
import ast
import context
import tables
import json
import build
import loc
import obligations
import defs

-- The ledgers a project keeps under `<root>/.onus/ledger/` (`report/ledger.ts`,
-- §20.3–§20.5): the assumption verifications `onus test --assumptions`
-- records, the runtime-check coverage a test run leaves, and the contract
-- mutations `onus test --mutate` reports. The reports read them; a file that
-- is absent or malformed reads as empty, as the TypeScript command line
-- treats it.
pub record Ledger {
  assumptions: Dict[Text, tables.VerificationRecord]
  coverage: Dict[Text, Int]
  mutations: List[tables.MutationRecord]
  -- Promotions and demotions in order (§21.3), from `promotions.json`.
  promotions: List[tables.PromotionRecord]
}

-- What counts as "in the module" or "on the path" for mutation records: a
-- module's qualified-name prefix, or the qualified names reachable on a path.
pub record Scope {
  prefix: Option[Text]
  names: Dict[Text, Bool]
}

fn skip() -> Unit {
  return Unit
}

fn read_json(files: io.Files, path: Text) -> Option[json.Json] may io.file, alloc, mutate {
  match io.read(files: files, path: path) with
  | Ok(value) -> return json.parse(t: value)
  | Err(_) -> return None
}

fn record_of(j: json.Json) -> Option[tables.VerificationRecord] may alloc {
  if not (json.has(j: j, key: "at") and json.has(j: j, key: "target") and json.has(
    j: j,
    key: "result"
  ) and json.has(j: j, key: "claim") and json.has(j: j, key: "def")) {
    return None
  }
  let outcome: Text = json.str_at(j: j, key: "result")
  if outcome != "passed" and outcome != "failed" {
    return None
  }
  return Some(
    value: tables.VerificationRecord {
      at: json.str_at(j: j, key: "at"),
      target: json.str_at(j: j, key: "target"),
      outcome: outcome,
      claim: json.str_at(j: j, key: "claim"),
      def: json.str_at(j: j, key: "def")
    }
  )
}

fn put_record(
  out: inout Dict[Text, tables.VerificationRecord],
  key: Text,
  r: Option[tables.VerificationRecord]
) -> Unit may mutate, alloc {
  match r with
  | Some(value) -> Map.set(d: inout out, key: key, value: value)
  | None -> skip()
  return Unit
}

fn put_count(out: inout Dict[Text, Int], key: Text, n: Option[Int]) -> Unit may mutate, alloc {
  match n with
  | Some(value) -> Map.set(d: inout out, key: key, value: value)
  | None -> skip()
  return Unit
}

fn read_assumptions(
  files: io.Files,
  path: Text
) -> Dict[Text, tables.VerificationRecord] may io.file, alloc, mutate {
  var out: Dict[Text, tables.VerificationRecord] = Map.dict()
  match read_json(files: files, path: path) with
  | Some(value) -> {
    match value with
    | json.JObject(fields) -> {
      for f: json.Field in fields {
        put_record(out: inout out, key: f.key, r: record_of(j: f.value))
      }
    }
    | _ -> skip()
  }
  | None -> skip()
  return out
}

fn read_coverage(files: io.Files, path: Text) -> Dict[Text, Int] may io.file, alloc, mutate {
  var out: Dict[Text, Int] = Map.dict()
  match read_json(files: files, path: path) with
  | Some(value) -> {
    match value with
    | json.JObject(fields) -> {
      for f: json.Field in fields {
        match f.value with
        | json.JNumber(text) -> put_count(out: inout out, key: f.key, n: Int.parse(t: text))
        | _ -> skip()
      }
    }
    | _ -> skip()
  }
  | None -> skip()
  return out
}

fn is_mutation_kind(k: Text) -> Bool {
  return k == "drop-ensures" or k == "widen-return" or k == "widen-field" or k == "negate-guard"
}

fn read_mutations(
  files: io.Files,
  path: Text
) -> List[tables.MutationRecord] may io.file, alloc, mutate {
  var out: Builder[tables.MutationRecord] = List.builder()
  match read_json(files: files, path: path) with
  | Some(value) -> {
    for r: json.Json in json.list_at(j: value, key: "results") {
      let kind: Text = json.str_at(j: r, key: "kind")
      let detected: json.Json = json.at(j: r, key: "detected")
      if is_mutation_kind(k: kind) and json.at(j: r, key: "def") is json.JString and json.at(
        j: r,
        key: "text"
      ) is json.JString and detected is json.JBool and json.at(j: r, key: "by") is json.JString {
        List.push(
          b: inout out,
          x: tables.MutationRecord {
            kind: kind,
            def: json.str_at(j: r, key: "def"),
            text: json.str_at(j: r, key: "text"),
            detected: json.bool_at(j: r, key: "detected"),
            by: json.str_at(j: r, key: "by")
          }
        )
      }
    }
  }
  | None -> skip()
  return List.finish(b: out)
}

-- Reads the three ledgers under `dir`; each is empty when absent or malformed.
pub fn read_ledger(files: io.Files, dir: Text) -> Ledger may io.file, alloc, mutate {
  return Ledger {
    assumptions: read_assumptions(files: files, path: dir ++ "/assumptions.json"),
    coverage: read_coverage(files: files, path: dir ++ "/coverage.json"),
    mutations: read_mutations(files: files, path: dir ++ "/mutations.json"),
    promotions: read_promotions(files: files, path: dir ++ "/promotions.json")
  }
}

fn read_promotions(
  files: io.Files,
  path: Text
) -> List[tables.PromotionRecord] may io.file, alloc, mutate {
  var out: Builder[tables.PromotionRecord] = List.builder()
  match read_json(files: files, path: path) with
  | None -> skip()
  | Some(value) -> push_promotions(items: json.list_of(j: value), out: inout out)
  return List.finish(b: out)
}

fn push_promotions(
  items: List[json.Json],
  out: inout Builder[tables.PromotionRecord]
) -> Unit may alloc, mutate {
  for j: json.Json in items {
    match promotion_of(j: j) with
    | Some(value) -> List.push(b: inout out, x: value)
    | None -> skip()
  }
  return Unit
}

fn promotion_of(j: json.Json) -> Option[tables.PromotionRecord] may alloc {
  if not (json.has(j: j, key: "module") and json.has(j: j, key: "from") and json.has(
    j: j,
    key: "to"
  ) and json.has(j: j, key: "at") and json.has(j: j, key: "kind")) {
    return None
  }
  return Some(
    value: tables.PromotionRecord {
      module: json.str_at(j: j, key: "module"),
      from: json.str_at(j: j, key: "from"),
      to: json.str_at(j: j, key: "to"),
      at: json.str_at(j: j, key: "at"),
      kind: json.str_at(j: j, key: "kind"),
      audit: json.str_at(j: j, key: "audit")
    }
  )
}

pub fn promotion_json(r: tables.PromotionRecord) -> json.Json may alloc {
  return json.JObject(
    fields: [
      json.field(key: "module", value: json.text(t: r.module)),
      json.field(key: "from", value: json.text(t: r.from)),
      json.field(key: "to", value: json.text(t: r.to)),
      json.field(key: "at", value: json.text(t: r.at)),
      json.field(key: "kind", value: json.text(t: r.kind)),
      json.field(key: "audit", value: json.text(t: r.audit))
    ]
  )
}

-- Writes the promotions ledger under `dir`.
pub fn write_promotions(
  files: io.Files,
  dir: Text,
  records: List[tables.PromotionRecord]
) -> Result[Unit, io.Error] may io.file, alloc, mutate {
  var items: Builder[json.Json] = List.builder()
  for r: tables.PromotionRecord in records {
    List.push(b: inout items, x: promotion_json(r: r))
  }
  try io.mkdir(files: files, path: dir)
  try build.write_file(
    files: files,
    path: dir ++ "/promotions.json",
    text: json.pretty(j: json.JArray(items: List.finish(b: items))) ++ "\n"
  )
  return Ok(value: Unit)
}

-- The modules whose latest record is a demotion (§21.3): dependents' guarantees on them are conditional.
pub fn demoted_modules(
  records: List[tables.PromotionRecord]
) -> Dict[Text, Bool] may alloc, mutate {
  var out: Dict[Text, Bool] = Map.dict()
  for r: tables.PromotionRecord in records {
    Map.set(d: inout out, key: r.module, value: r.kind == "demotion")
  }
  var demoted: Dict[Text, Bool] = Map.dict()
  for name: Text in Map.keys(d: out) {
    match Map.find(d: out, key: name) with
    | Some(value) -> {
      if value {
        Map.set(d: inout demoted, key: name, value: true)
      }
    }
    | None -> skip()
  }
  return demoted
}

-- Whether the assumption under `key` has a passing verification record. The
-- record's age is not yet checked: that needs a clock the standard library
-- does not expose (`io.Clock` has no reading primitive), so a passing record
-- stays current.
-- Whether the ledger holds a passing verification of the assumption `key`
-- no older than the context's maximum age at the context's time (§20.3;
-- docs/CHANGES.md item 199: the age was not checked before).
pub fn is_verified(ctx: context.Context, key: Text) -> Bool may alloc {
  match Map.find(d: ctx.assumptions, key: key) with
  | Some(value) -> return is_current(
    r: value,
    now_ms: ctx.now_ms,
    max_age_ms: ctx.assumption_max_age_ms
  )
  | None -> return false
}

-- Whether a record is a passing verification dated within `max_age_ms` of `now_ms`.
pub fn is_current(r: tables.VerificationRecord, now_ms: Int, max_age_ms: Int) -> Bool may alloc {
  if r.outcome != "passed" {
    return false
  }
  match millis_of_iso(t: r.at) with
  | Some(value) -> return now_ms - value <= max_age_ms
  | None -> return false
}

-- Milliseconds since 1970-01-01T00:00:00 UTC of an instant written as
-- `YYYY-MM-DDTHH:MM:SSZ` or `YYYY-MM-DDTHH:MM:SS.mmmZ` (the inverse of
-- `assumptions.iso_of_millis`, by Hinnant's days-from-civil), or nothing
-- for any other text or a year before 1970.
pub fn millis_of_iso(t: Text) -> Option[Int] may alloc {
  let cps: List[Int] = Text.code_points(t: t)
  let n: Int = List.len(xs: cps)
  if n != 20 and n != 24 {
    return None
  }
  if cp_at(cps: cps, i: 4) != 45 or cp_at(cps: cps, i: 7) != 45 or cp_at(
    cps: cps,
    i: 10
  ) != 84 or cp_at(cps: cps, i: 13) != 58 or cp_at(cps: cps, i: 16) != 58 or cp_at(
    cps: cps,
    i: n - 1
  ) != 90 {
    return None
  }
  if n == 24 and cp_at(cps: cps, i: 19) != 46 {
    return None
  }
  let year: Int = digits_at(cps: cps, from: 0, count: 4)
  let month: Int = digits_at(cps: cps, from: 5, count: 2)
  let day: Int = digits_at(cps: cps, from: 8, count: 2)
  let hours: Int = digits_at(cps: cps, from: 11, count: 2)
  let minutes: Int = digits_at(cps: cps, from: 14, count: 2)
  let seconds: Int = digits_at(cps: cps, from: 17, count: 2)
  var millis: Int = 0
  if n == 24 {
    millis = digits_at(cps: cps, from: 20, count: 3)
  }
  if year < 1970 or month < 1 or month > 12 or day < 1 or day > 31 or hours < 0 or minutes < 0 or seconds < 0 or millis < 0 {
    return None
  }
  var y: Int = year
  if month <= 2 {
    y = year - 1
  }
  let era: Int = y / 400
  let yoe: Int = y - era * 400
  var mp: Int = month + 9
  if month > 2 {
    mp = month - 3
  }
  let doy: Int = (153 * mp + 2) / 5 + day - 1
  let doe: Int = yoe * 365 + yoe / 4 - yoe / 100 + doy
  let days: Int = era * 146097 + doe - 719468
  return Some(value: days * 86400000 + hours * 3600000 + minutes * 60000 + seconds * 1000 + millis)
}

fn cp_at(cps: List[Int], i: Int) -> Int {
  if i >= 0 and i < List.len(xs: cps) {
    return List.get(xs: cps, i: i)
  }
  return -1
}

-- The decimal number written by `count` digits from `from`, or -1 when one is not a digit.
fn digits_at(cps: List[Int], from: Int, count: Int where it >= 0) -> Int {
  var n: Int = 0
  for k: Int in 0 ..< count {
    let cp: Int = cp_at(cps: cps, i: from + k)
    if cp < 48 or cp > 57 {
      return -1
    }
    n = n * 10 + (cp - 48)
  }
  return n
}

example millis_of_iso {
  millis_of_iso(t: "1970-01-01T00:00:00.000Z") == Some(value: 0)
  millis_of_iso(t: "1970-01-02T00:00:00Z") == Some(value: 86400000)
  millis_of_iso(t: "2026-09-07T11:56:36.099Z") == Some(value: 1788782196099)
  millis_of_iso(t: "2020-01-01T00:00:00.000Z") == Some(value: 1577836800000)
  millis_of_iso(t: "2026-09-07") == None
  millis_of_iso(t: "2026-13-07T11:56:36.099Z") == None
  millis_of_iso(t: "1969-12-31T23:59:59.999Z") == None
}

-- The ledger's record for an assumption as the reports show it, or null.
pub fn verified_json(ctx: context.Context, key: Text) -> json.Json may alloc {
  match Map.find(d: ctx.assumptions, key: key) with
  | Some(value) -> return json.JObject(
    fields: [
      json.field(key: "at", value: json.text(t: value.at)),
      json.field(key: "target", value: json.text(t: value.target)),
      json.field(key: "result", value: json.text(t: value.outcome))
    ]
  )
  | None -> return json.JNull
}

-- The ledger key of the `assume` statement with node key `node`, or "" when the claims pass recorded none.
pub fn site_key_at(ctx: context.Context, node: Int) -> Text may alloc {
  for s: tables.AssumeSite in List.finish(b: ctx.assume_sites) {
    if s.node == node {
      return s.key
    }
  }
  return ""
}

pub fn in_scope(scope: Scope, def: Text) -> Bool {
  match scope.prefix with
  | Some(value) -> return Text.starts_with(t: def, prefix: value)
  | None -> return Map.contains(d: scope.names, key: def)
}

-- The `file:line:col` the runtime check for `o` reports (`coverage.ts`
-- `checkSite`): a refinement on an argument is checked once at the callee's
-- parameter, anything else at its own node.
pub fn check_site(
  ctx: context.Context,
  tab: Dict[Int, loc.LineTable],
  o: obligations.Obligation
) -> Text may alloc {
  var file: Int = o.at_file
  var span: ast.Span = o.at_span
  if o.callee is Some and o.param is Some {
    match param_def(ctx: ctx, callee: or_int(o: o.callee), name: or_text(o: o.param)) with
    | Some(value) -> {
      let d: defs.Def = context.get_def(ctx: ctx, id: value)
      file = d.file
      span = d.span
    }
    | None -> skip()
  }
  return loc.location_text(ctx: ctx, tables: tab, file: file, span: span)
}

-- The definition of the parameter `name` of `callee`, when the signature has it.
fn param_def(ctx: context.Context, callee: Int, name: Text) -> Option[Int] {
  match Map.find(d: ctx.signatures, key: callee) with
  | Some(value) -> {
    for i: Int in 0 ..< List.len(xs: value.params) {
      if List.get(xs: value.params, i: i).name == name and i < List.len(xs: value.param_defs) {
        return Some(value: List.get(xs: value.param_defs, i: i))
      }
    }
    return None
  }
  | None -> return None
}

fn or_int(o: Option[Int]) -> Int {
  match o with
  | Some(value) -> return value
  | None -> return -1
}

fn or_text(o: Option[Text]) -> Text {
  match o with
  | Some(value) -> return value
  | None -> return ""
}
