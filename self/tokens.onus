module tokens

-- The tokens of the Onus lexical grammar (spec §2; docs/grammar-v0.md), for
-- the compiler in Onus (impl spec M15.1). Positions count code points.
pub union Kind =
  | Name of text: Text
  | TName of text: Text
  | IntLit of value: Int, text: Text
  | FloatLit of value: Float
  | TextLit of value: Text
  | DurationLit of nanos: Int
  | Keyword of word: Text
  | Punct of text: Text
  | Newline
  | Eof

pub record Token {
  kind: Kind
  start: Int where it >= 0
  end: Int where it >= 0
}

pub record Comment {
  start: Int where it >= 0
  end: Int where it >= 0
  own_line: Bool
}

pub record Diagnostic {
  code: Text
  start: Int where it >= 0
  end: Int where it >= 0
  detail: Text
}

