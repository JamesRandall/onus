module std.text

pub const intrinsic fn len(t: Text) -> Int where it >= 0

pub const intrinsic fn graphemes(t: Text) -> List[Text] may alloc
  ensures List.len(xs: result) == len(t: t)

pub const intrinsic fn bytes(t: Text) -> Bytes may alloc

pub const intrinsic fn starts_with(t: Text, prefix: Text) -> Bool

pub const intrinsic fn lower(t: Text) -> Text may alloc

pub const intrinsic fn trim(t: Text) -> Text may alloc
