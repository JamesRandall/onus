module std.typeinfo
import std.host

-- What a `const fn` sees of a type passed as a value (§3.8.1).
pub record Field {
  name: Text
  type_name: Text
}

pub const intrinsic fn name(t: TypeInfo) -> Text may alloc
  claims host.js

pub const intrinsic fn fields(t: TypeInfo) -> List[Field] may alloc
  claims host.js
