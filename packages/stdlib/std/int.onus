module std.int

pub union RangeError =
  | NotFinite
  | OutOfRange

pub const intrinsic fn to_text(x: Int) -> Text may alloc

pub const intrinsic fn floor(x: Float) -> Result[Int, RangeError]

pub fn abs(x: Int) -> Int where it >= 0
  ensures result == x or result == -x
{
  if x < 0 {
    return -x
  }
  return x
}

-- A decimal integer with an optional sign, nothing else; None for anything
-- malformed or outside 64 bits.
pub const intrinsic fn parse(t: Text) -> Option[Int]

example parsing {
  parse(t: "42") == Some(value: 42)
  parse(t: "-7") == Some(value: -7)
  parse(t: "4x") is None
  parse(t: "") is None
  parse(t: "99999999999999999999") is None
}
