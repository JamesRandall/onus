module std.int

pub union RangeError =
  | NotFinite
  | OutOfRange

pub const intrinsic fn to_text(x: Int) -> Text may alloc

pub const intrinsic fn floor(x: Float) -> Result[Int, RangeError]

pub fn abs(x: Int) -> Int where it >= 0
  ensures result == x or result == -x
{
  if x < 0 {
    return -x
  }
  return x
}
