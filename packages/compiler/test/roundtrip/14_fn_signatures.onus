module sig

fn pure_fn(x: Int) -> Int {
  return x
}

pub fn effectful(files: io.Files, path: Text) -> Result[Unit, io.Error] may io.file, alloc {
  return Ok(value: Unit)
}

pub fn gen[T: Ord, U, const n: Int, e](
  xs: List[T],
  f: fn(x: T) -> U may e
) -> List[U] may e, alloc {
  return []
}

fn mutating(grid: inout Grid[T, w, h], x: Int, value: T) -> Unit may mutate
  requires x < w
  ensures grid.get(x: x) == value
{
  return Unit
}

fn contracted(limit: Iter) -> Iter
  requires proved limit > 0
  ensures proved result <= limit
{
  return limit
}

pub const fn parse_select(text: Text) -> Result[SelectAst, ConstError]
  ensures result is Ok
{
  return Err(error: ConstError { offset: 0 })
}

pub fn claiming(pay: Payments) -> Result[Receipt, ChargeError] may io.net
  claims Idempotent, audit.Audited
{
  assume Idempotent "Vendor API deduplicates on req.key for 24h; see contract §4.2"
  return Err(error: Declined)
}

pub sealed fn sealed_fn() -> Unit {
  return Unit
}

fn fact(n: Int where it >= 0) -> Int where it >= 1
  requires n >= 0
  decreases n
{
  if n == 0 {
    return 1
  }
  return n * fact(n: n - 1)
}
