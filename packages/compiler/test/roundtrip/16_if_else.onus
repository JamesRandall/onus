module ifs

fn clamp(x: Int, lo: Int, hi: Int where it >= lo) -> Int where lo <= it and it <= hi {
  if x < lo {
    return lo
  }
  if x > hi {
    return hi
  } else {
    return x
  }
}

fn chain(x: Int) -> Int {
  if x < 0 {
    return -1
  } else {
    if x == 0 {
      return 0
    } else {
      return 1
    }
  }
}

fn nested(a: Bool, b: Bool) -> Int {
  if a {
    if b {
      return 2
    }
    return 1
  }
  return 0
}
