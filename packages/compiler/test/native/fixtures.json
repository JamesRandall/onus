{
  "sections": [
    {
      "kind": "examples",
      "requires": [
        "clang"
      ],
      "sources": [
        "../../../../examples/mandelbrot/mandelbrot.onus",
        "primitives.onus",
        "eq_recursive.onus",
        "dict.onus",
        "generics.onus",
        "text_native.onus",
        "function_values.onus",
        "old_native.onus",
        "inout_conditions.onus",
        "../codegen/features.onus",
        "../stdlib/list_generic.onus",
        "../verify/ok_interface_calls.onus"
      ]
    },
    {
      "kind": "examples",
      "requires": [
        "clang"
      ],
      "allow_refusal": true,
      "skip_prefixes": [
        "e0"
      ],
      "dirs": [
        "../checker",
        "../paths",
        "../codegen",
        "../stdlib",
        "."
      ]
    },
    {
      "kind": "examples",
      "name": "broken-runtime",
      "requires": [
        "clang"
      ],
      "sources": [
        "primitives.onus"
      ],
      "cflags": [
        "-DONUS_BROKEN_INT_TO_TEXT"
      ],
      "expect_disagreement": true
    },
    {
      "kind": "builds",
      "requires": [
        "clang"
      ],
      "cases": [
        {
          "source": "e0800_dict_key.onus",
          "targets": [
            "native"
          ],
          "expect": [
            "E0800"
          ]
        }
      ]
    },
    {
      "kind": "programs",
      "name": "native",
      "requires": [
        "clang"
      ],
      "cases": [
        {
          "source": "process_native.onus",
          "args": [
            "one",
            "two"
          ],
          "stdout": "process_native.out",
          "stderr_text": "",
          "files_text": {
            "made/deep/dir/note.txt": "hello native\n"
          }
        },
        {
          "source": "clock_native.onus",
          "stdout_text": "ok\n",
          "stderr_text": ""
        },
        {
          "source": "time_native.onus",
          "stdout_text": "ok\n",
          "stderr_text": ""
        },
        {
          "source": "http_native.onus",
          "via": "http_server.sh",
          "stdout": "http_native.out",
          "stderr_text": ""
        },
        {
          "source": "exec_native.onus",
          "stdout": "exec_native.out"
        },
        {
          "source": "status_native.onus",
          "status": 3,
          "stdout_text": "exiting with 3\n",
          "stderr_text": ""
        },
        {
          "source": "remove_native.onus",
          "stdout": "remove_native.out",
          "stderr_text": "",
          "files_absent": [
            "tree"
          ]
        },
        {
          "source": "list_native.onus",
          "stdout": "list_native.out",
          "stderr_text": ""
        }
      ]
    },
