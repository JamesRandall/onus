module readonly
import std.io
import std.sql

record Setting {
  value: Text
}

pub fn main(
  args: List[Text],
  env: io.Env,
  files: io.Files,
  net: io.Net
) -> Result[Unit, sql.Error] may io.env, io.file, io.net, sql.read, alloc {
  let dsn: Text = try io.get_env(env: env, name: "ONUS_TEST_DSN")
    else _: Malformed(detail: "ONUS_TEST_DSN is not set")
  let db: sql.Db[ReadOnly] = try sql.connect(net: net, dsn: dsn, mode: ReadOnly)
  let stmt: sql.Select[Setting] = sql.select[
    text: "select current_setting('default_transaction_read_only') as value from pg_database limit 1"
  ](params: [], row: Setting)
  let rows: List[Setting] = try sql.query(db: db, statement: stmt)
  let out: io.File = try io.create(files: files, path: "readonly.txt")
    else e: Malformed(detail: "cannot write")
  for row: Setting in rows {
    try io.write(file: out, text: row.value ++ "\n") else e: Malformed(detail: "cannot write")
  }
  return Ok(value: Unit)
}
