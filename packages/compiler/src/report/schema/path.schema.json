{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://onus-lang.dev/schema/v0/path.json",
  "title": "Onus path report (language spec \u00a79.1)",
  "type": "object",
  "required": [
    "path",
    "entry",
    "reachable",
    "effects",
    "claims",
    "assumes",
    "obligations",
    "unresolvable_calls",
    "capabilities",
    "ok",
    "graph",
    "gates",
    "recovers",
    "ledger"
  ],
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string"
    },
    "entry": {
      "type": "string"
    },
    "reachable": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effects": {
      "type": "object",
      "required": [
        "bound",
        "forbid",
        "actual"
      ],
      "additionalProperties": false,
      "properties": {
        "bound": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "forbid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actual": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "required": [
        "required",
        "satisfied"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "satisfied": {
          "type": "boolean"
        }
      }
    },
    "assumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "at",
          "justification",
          "permitted_by",
          "verifiable",
          "last_verified"
        ],
        "additionalProperties": false,
        "properties": {
          "claim": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "justification": {
            "type": "string"
          },
          "permitted_by": {
            "enum": [
              "scope",
              "except",
              null
            ]
          },
          "verifiable": {
            "type": "boolean"
          },
          "last_verified": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "at",
                  "target",
                  "result"
                ],
                "additionalProperties": false,
                "properties": {
                  "at": {
                    "type": "string"
                  },
                  "target": {
                    "type": "string"
                  },
                  "result": {
                    "enum": [
                      "passed",
                      "failed"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "obligations": {
      "type": "object",
      "required": [
        "proved",
        "checked",
        "assumed",
        "failed",
        "checked_at"
      ],
      "additionalProperties": false,
      "properties": {
        "proved": {
          "type": "integer",
          "minimum": 0
        },
        "checked": {
          "type": "integer",
          "minimum": 0
        },
        "assumed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "checked_at": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "unresolvable_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "constructed_at",
          "assumes"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "constructed_at": {
            "type": "string"
          },
          "assumes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "ok": {
      "type": "boolean"
    },
    "graph": {
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ],
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "module",
              "kind",
              "effects",
              "claims",
              "obligations",
              "assumes",
              "recovers",
              "unresolvable"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "module": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "entry",
                  "fn",
                  "intrinsic"
                ]
              },
              "effects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "obligations": {
                "type": "object",
                "required": [
                  "proved",
                  "checked",
                  "assumed",
                  "failed"
                ],
                "additionalProperties": false,
                "properties": {
                  "proved": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "checked": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "assumed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "assumes": {
                "type": "integer",
                "minimum": 0
              },
              "recovers": {
                "type": "integer",
                "minimum": 0
              },
              "unresolvable": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "effects",
              "at"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "effects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "at": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence",
          "producers",
          "guarded"
        ],
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "type": "string"
          },
          "producers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "guarded": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "recovers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "def",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "def": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      }
    },
    "ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "text",
          "def",
          "status",
          "by",
          "pinned",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "def": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "by": {
            "type": [
              "string",
              "null"
            ]
          },
          "pinned": {
            "type": "boolean"
          },
          "at": {
            "type": "string"
          }
        }
      }
    }
  }
}
