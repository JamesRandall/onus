module e0334_impl_mismatch

interface Codec[T] {
  fn encode(value: T) -> Text may alloc

  fn decode(text: Text) -> Result[T, Text] may alloc
}

record Pair {
  a: Int
}

impl Codec[Pair] {
  fn encode(v: Pair) -> Text may alloc {
    return "pair"
  }

  fn extra() -> Int {
    return 1
  }
}

impl Codec[Int] {
  fn encode(value: Int) -> Int may alloc {
    return value
  }

  fn decode(text: Text) -> Result[Int, Text] may alloc {
    return Ok(value: 1)
  }
}

impl Codec[Int] {
  fn encode(value: Int) -> Text may alloc {
    return "x"
  }

  fn decode(text: Text) -> Result[Int, Text] may alloc {
    return Ok(value: 1)
  }
}
