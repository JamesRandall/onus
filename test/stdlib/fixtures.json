{
  "sections": [
    {
      "kind": "diagnostics",
      "to": "paths",
      "dir": "../../packages/stdlib/std",
      "root": "../../packages/stdlib/std",
      "budget": 2000,
      "expect_none": true
    },
    {
      "kind": "examples",
      "targets": [
        "js"
      ],
      "properties": true,
      "sources": [
        "text_ops.onus",
        "list_ops.onus",
        "list_generic.onus",
        "map_ops.onus",
        "hash_ops.onus",
        "view_ops.onus"
      ]
    },
    {
      "kind": "programs",
      "name": "stdlib-js",
      "cases": [
        {
          "source": "process_program.onus",
          "targets": [
            "js"
          ],
          "stdout_text": "0 hello\npiped\nmissing\n"
        },
        {
          "source": "io_program.onus",
          "targets": [
            "js"
          ],
          "stdout_text": "3 parts\n",
          "stderr_text": "done\n",
          "files_text": {
            "roundtrip.txt": "one\ntwo\n"
          }
        },
        {
          "source": "blake3_lengths.onus",
          "targets": [
            "js"
          ],
          "stdout": "blake3_lengths.out"
        }
      ]
    },
    {
      "kind": "programs",
      "name": "stdlib-native",
      "requires": [
        "clang"
      ],
      "cases": [
        {
          "source": "io_program.onus",
          "stdout_text": "3 parts\n",
          "stderr_text": "done\n",
          "files_text": {
            "roundtrip.txt": "one\ntwo\n"
          }
        },
        {
          "source": "blake3_lengths.onus",
          "stdout": "blake3_lengths.out",
          "same_stdout": true
        }
      ]
    }
  ]
}
